    <script>
      // The ladder is read from the API rather than written into the page, so this
  // can never quietly disagree with what a receipt is actually paid.
  const MAT = { paper: &#34;t-paper&#34;, silver: &#34;t-silver&#34;, gold: &#34;t-gold&#34;, black: &#34;t-black&#34;, founder: &#34;t-founder&#34; };
  const usd = (n) =&gt; &#34;$&#34; + Number(n).toLocaleString(&#34;en-US&#34;);
  fetch(&#34;/api/status&#34;).then((r) =&gt; r.json()).then((j) =&gt; {
    // The window is a server setting, so this section is written from it
    // rather than promising a rule the server may not be applying.
    const hours = Number((j.rule &amp;&amp; j.rule.tierHighWaterHours) || 0);
    if (hours &gt; 0) {
      const span = hours === 24 ? &#34;24 hours&#34; : hours + (hours === 1 ? &#34; hour&#34; : &#34; hours&#34;);
      document.getElementById(&#34;hw-h&#34;).textContent = &#34;The high-water mark&#34;;
      document.getElementById(&#34;hw-p&#34;).innerHTML = &#34;A tier is held for &lt;b&gt;&#34; + span
        + &#34;&lt;/b&gt; from the moment it is reached. Selling does not drop it, and a price dip does not either \u2014 the way up is immediate, the way down is slow. When the window rolls over, the tier is whatever the balance is worth then.&#34;;
    }
    const all = (j.rule &amp;&amp; j.rule.tiers) || [];
    // Holder tiers only. The zero-minimum floor asks for no holding at all, so
    // it is not a rung anyone climbs to — naming it here would only blur what
    // the word &#34;tier&#34; means.
    const tiers = all.filter((t) =&gt; t.minUsd &gt; 0);
    // Cents only when there are any: a quarter of a day lands on $31.25, but
    // $125 should not read as $125.00.
    const money = (n) =&gt; &#34;$&#34; + (Number.isInteger(n) ? n.toLocaleString(&#34;en-US&#34;) : n.toFixed(2));
    document.getElementById(&#34;ladder&#34;).innerHTML = tiers.map((t) =&gt; {
      return `&lt;div class=&#34;tier ${MAT[t.name] || &#34;t-silver&#34;}&#34;&gt;
        &lt;div class=&#34;tier-top&#34;&gt;
          &lt;span class=&#34;tier-name&#34;&gt;${t.label}&lt;/span&gt;
          &lt;span class=&#34;tier-hold&#34;&gt;Hold ${usd(t.minUsd)} &lt;span&gt;of $RECEIPT&lt;/span&gt;&lt;/span&gt;
        &lt;/div&gt;
        &lt;div class=&#34;tier-grid&#34;&gt;
          ${(t.maxPerDayUsd / (t.percent / 100)) &lt; 25
            ? `&lt;div&gt;&lt;div class=&#34;k&#34;&gt;Back&lt;/div&gt;&lt;b&gt;All of it&lt;/b&gt;&lt;div class=&#34;k&#34; style=&#34;margin-top:5px;letter-spacing:.08em&#34;&gt;up to the day&#39;s cap&lt;/div&gt;&lt;/div&gt;`
            : `&lt;div&gt;&lt;div class=&#34;k&#34;&gt;Back&lt;/div&gt;&lt;b&gt;${t.percent}%&lt;/b&gt;&lt;div class=&#34;k&#34; style=&#34;margin-top:5px;letter-spacing:.08em&#34;&gt;of every receipt&lt;/div&gt;&lt;/div&gt;`}
          &lt;div&gt;&lt;div class=&#34;k&#34;&gt;Per day&lt;/div&gt;&lt;b&gt;${usd(t.maxPerDayUsd)}&lt;/b&gt;&lt;div class=&#34;k&#34; style=&#34;margin-top:5px;letter-spacing:.08em&#34;&gt;at most&lt;/div&gt;&lt;/div&gt;
          &lt;div&gt;&lt;div class=&#34;k&#34;&gt;Per month&lt;/div&gt;&lt;b&gt;${usd(t.maxPerDayUsd * 30)}&lt;/b&gt;&lt;div class=&#34;k&#34; style=&#34;margin-top:5px;letter-spacing:.08em&#34;&gt;at most&lt;/div&gt;&lt;/div&gt;
          &lt;div&gt;&lt;div class=&#34;k&#34;&gt;Receipts&lt;/div&gt;&lt;b&gt;${t.maxReceiptsPerDay}&lt;/b&gt;&lt;div class=&#34;k&#34; style=&#34;margin-top:5px;letter-spacing:.08em&#34;&gt;a day&lt;/div&gt;&lt;/div&gt;
        &lt;/div&gt;
        &lt;div class=&#34;tier-lock&#34;&gt;
          &lt;span class=&#34;tl-tag&#34;&gt;Staked&lt;/span&gt;
          &lt;span&gt;&lt;b&gt;${t.percent + 2}%&lt;/b&gt; back · &lt;b&gt;${money(Math.round(t.maxPerDayUsd * 1.25 * 100) / 100)}&lt;/b&gt; a day
          &lt;i&gt;+2% and +25% for staking $RECEIPT&lt;/i&gt;&lt;/span&gt;
        &lt;/div&gt;
      &lt;/div&gt;`;
    }).join(&#34;&#34;);
    // The worked example uses a real tier&#39;s real ceiling, so the arithmetic on
  // the page is the arithmetic the server would do.
  const ex = tiers.find((t) =&gt; t.name === &#34;gold&#34;) || tiers[0];
  if (ex) {
    const spend = 50;
    const money = (n) =&gt; &#34;$&#34; + Number(n).toFixed(2);
    // The same arithmetic the server does: the rate, capped by the day.
    const back = Math.min(Math.floor(spend * ex.percent) / 100, ex.maxPerDayUsd);
    document.getElementById(&#34;ex-total&#34;).textContent = money(spend);
    document.getElementById(&#34;ex-cap&#34;).textContent = ex.percent + &#34;%&#34;;
    document.getElementById(&#34;ex-match&#34;).textContent = money(back);
    document.getElementById(&#34;ex-back&#34;).textContent = money(back) + &#34; in COST&#34;;
    document.querySelector(&#34;.sheet .k&#34;).textContent = &#34;Worked example \u00b7 &#34; + ex.label;
  }

  const px = j.receiptToken &amp;&amp; j.receiptToken.priceUsd;
    document.getElementById(&#34;px&#34;).textContent = px
      ? &#34;$RECEIPT is $&#34; + (px &lt; 0.01 ? px.toFixed(6) : px.toFixed(4)) + &#34; today. Tier thresholds are in dollars, so they hold as the price moves.&#34;
      : &#34;Tier thresholds are in dollars, so they hold as the price moves.&#34;;
  }).catch(() =&gt; {
    document.getElementById(&#34;px&#34;).textContent = &#34;Tier thresholds are in dollars, so they hold as the price moves.&#34;;
  });
    </script>
  </body>
</html>
