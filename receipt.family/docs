    <script>
      // Highlight the section in view.
  var links = [].slice.call(document.querySelectorAll(&#39;.nav a&#39;));
  var map = {};
  links.forEach(function (a) { map[a.getAttribute(&#39;href&#39;).slice(1)] = a; });
  var seen = new Set();
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { e.isIntersecting ? seen.add(e.target.id) : seen.delete(e.target.id); });
    var order = Object.keys(map);
    var top = order.find(function (id) { return seen.has(id); });
    links.forEach(function (a) { a.classList.toggle(&#39;on&#39;, a === map[top]); });
  }, { rootMargin: &#39;0px 0px -70% 0px&#39; });
  document.querySelectorAll(&#39;section[id]&#39;).forEach(function (s) { io.observe(s); });

  // Filter the contents.
  var filter = document.getElementById(&#39;filter&#39;), nav = document.getElementById(&#39;nav&#39;);
  filter.addEventListener(&#39;input&#39;, function () {
    var q = filter.value.trim().toLowerCase();
    nav.classList.toggle(&#39;filtered&#39;, !!q);
    var hits = 0;
    links.forEach(function (a) {
      var hit = !q || a.textContent.toLowerCase().indexOf(q) &gt; -1;
      a.style.display = hit ? &#39;&#39; : &#39;none&#39;;
      if (hit) hits++;
    });
    nav.classList.toggle(&#39;none&#39;, q &amp;&amp; !hits);
  });

  // Mobile contents toggle.
  var bar = document.getElementById(&#39;bar&#39;), side = document.getElementById(&#39;side&#39;);
  bar.addEventListener(&#39;click&#39;, function () {
    var open = side.classList.toggle(&#39;open&#39;);
    bar.setAttribute(&#39;aria-expanded&#39;, String(open));
    bar.querySelector(&#39;span&#39;).textContent = open ? &#39;−&#39; : &#39;+&#39;;
  });
  nav.addEventListener(&#39;click&#39;, function (e) { if (e.target.tagName === &#39;A&#39;) side.classList.remove(&#39;open&#39;); });

  // The tier-hold paragraph is written from the server&#39;s setting, the same
  // way /tiers does it, so this page can never promise a window the rule is
  // not applying. With the window off (the default) the text above stands.
  fetch(&#39;/api/status&#39;).then(function (r) { return r.json(); }).then(function (j) {
    var hours = Number((j.rule &amp;&amp; j.rule.tierHighWaterHours) || 0);
    if (!(hours &gt; 0)) return;
    var span = hours === 24 ? &#39;24 hours&#39; : hours + (hours === 1 ? &#39; hour&#39; : &#39; hours&#39;);
    document.getElementById(&#39;hw-h&#39;).textContent = &#39;The high-water mark&#39;;
    document.getElementById(&#39;hw-p&#39;).innerHTML = &#39;A tier is held for &lt;strong&gt;&#39; + span + &#39;&lt;/strong&gt; from the moment it is reached. Selling does not drop it, and a price dip does not either \u2014 the way up is immediate, the way down is slow. When the window rolls over, the tier is whatever the balance is worth then.&#39;;
  }).catch(function () {});
