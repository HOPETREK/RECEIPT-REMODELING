    </div>
    <script>
      // Everything numeric on this page comes from the server: the terms, the
  // early fee, the minimum, today&#39;s price and the tier ladder. The static
  // numbers in the markup are the defaults and are overwritten on load.
  const $ = (id) =&gt; document.getElementById(id);
  const usd = (n) =&gt; &#34;$&#34; + Number(n).toLocaleString(&#34;en-US&#34;, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const usd0 = (n) =&gt; &#34;$&#34; + Number(n).toLocaleString(&#34;en-US&#34;, { maximumFractionDigits: 0 });
  const int = (n) =&gt; Math.round(Number(n)).toLocaleString(&#34;en-US&#34;);
  const px6 = (p) =&gt; &#34;$&#34; + Number(p).toFixed(6);
  const days = (d) =&gt; d + &#34; day&#34; + (d === 1 ? &#34;&#34; : &#34;s&#34;);
  const EX_TOKENS = 100000;

  Promise.all([
    fetch(&#34;/api/status/locks&#34;).then((r) =&gt; (r.ok ? r.json() : null)).catch(() =&gt; null),
    fetch(&#34;/api/status&#34;).then((r) =&gt; (r.ok ? r.json() : null)).catch(() =&gt; null),
  ]).then(([L, S]) =&gt; {
    const terms = (L &amp;&amp; L.terms &amp;&amp; L.terms.length ? L.terms : [{ days: 3, creditPercent: 100 }, { days: 7, creditPercent: 110 }, { days: 30, creditPercent: 125 }]).slice().sort((a, b) =&gt; a.days - b.days);
    const best = terms[terms.length - 1];
    const fee = L &amp;&amp; Number.isFinite(L.earlyFeePercent) ? L.earlyFeePercent : 5;
    const minTokens = L &amp;&amp; L.minTokens ? L.minTokens : 1000;
    const price = (L &amp;&amp; L.priceUsd) || (S &amp;&amp; S.receiptToken &amp;&amp; S.receiptToken.priceUsd) || 0.00155;
    const enabled = L ? Boolean(L.enabled) : true;

    $(&#34;term-list&#34;).textContent = terms.map((t) =&gt; t.days).join(&#34;, &#34;).replace(/, (\d+)$/, &#34; or $1&#34;) + &#34; days&#34;;
    const mult = (t) =&gt; (t.creditPercent / 100).toFixed(2);
    const flat = terms.every((t) =&gt; t.creditPercent === best.creditPercent);
    $(&#34;terms&#34;).innerHTML = terms.map((t) =&gt; `&lt;div class=&#34;term${t === best ? &#34; best&#34; : &#34;&#34;}&#34;&gt;${t === best &amp;&amp; !flat ? &#39;&lt;span class=&#34;tag&#34;&gt;Best rate&lt;/span&gt;&#39; : &#34;&#34;}&lt;div class=&#34;d&#34;&gt;${t.days}&lt;small&gt;${t.days === 1 ? &#34;DAY&#34; : &#34;DAYS&#34;}&lt;/small&gt;&lt;/div&gt;&lt;div class=&#34;pc&#34;&gt;×${mult(t)}&lt;/div&gt;&lt;div class=&#34;k&#34;&gt;every token counts as ${t.creditPercent === 100 ? &#34;one&#34; : mult(t)}&lt;/div&gt;&lt;div class=&#34;x&#34;&gt;price held ${days(t.days)}&lt;/div&gt;&lt;/div&gt;`).join(&#34;&#34;);
    if (flat) $(&#34;terms-note&#34;).textContent = &#34;Every term counts the same. The longer the term, the longer your price is protected.&#34;;
    $(&#34;t-lock&#34;).textContent = terms[0].creditPercent === best.creditPercent ? best.creditPercent + &#34;%&#34; : `${terms[0].creditPercent} – ${best.creditPercent}%`;
    if (fee &gt; 0) { $(&#34;band-early&#34;).className = &#34;band rev&#34;; $(&#34;fee-line&#34;).innerHTML = `&lt;b&gt;${fee}%&lt;/b&gt; of the lock is kept as the early fee.`; }
    $(&#34;p-terms&#34;).textContent = terms.every((t) =&gt; t.creditPercent === 100)
      ? &#34;Every term counts the full value of the lock toward your tier, like tokens in the wallet, at the locked price or higher.&#34;
      : terms.map((t, i) =&gt; `${i === 0 ? `A ${t.days}-day lock counts ${t.creditPercent}% of its value toward your tier` : `${t.days} days ${t.creditPercent}%`}`).join(&#34;, &#34;) + &#34;.&#34;;
    $(&#34;p-px&#34;).textContent = `${px6(price)} right now`;
    $(&#34;p-early&#34;).textContent = fee &gt; 0
      ? `Unstake before the term ends and ${fee}% is kept; the cashback you earned while locked is yours. After the term, everything comes back.`
      : &#34;Unstake before the term ends and everything comes back, no fee. The cashback you earned while locked is yours to keep.&#34;;
    if (L &amp;&amp; L.perks) {
      const yr = Math.round(L.perks.receiptMaxAgeDays / 30) &gt;= 12;
      $(&#34;p-count&#34;).textContent = L.perks.receiptsPerDay;
      $(&#34;p-age&#34;).textContent = yr ? &#34;1 year&#34; : L.perks.receiptMaxAgeDays + &#34; days&#34;;
      $(&#34;p-age-w&#34;).textContent = yr ? &#34;a year&#34; : L.perks.receiptMaxAgeDays + &#34; days&#34;;
      $(&#34;p-age-n&#34;).textContent = L.perks.normalMaxAgeDays &gt;= 85 &amp;&amp; L.perks.normalMaxAgeDays &lt;= 95 ? &#34;Three months&#34; : L.perks.normalMaxAgeDays + &#34; days&#34;;
      const floorTier = ((S &amp;&amp; S.rule &amp;&amp; S.rule.tiers) || []).slice().sort((a, b) =&gt; a.minUsd - b.minUsd).find((t) =&gt; t.minUsd &gt;= L.perks.minUsd);
      $(&#34;vip-floor&#34;).textContent = floorTier ? floorTier.label : usd0(L.perks.minUsd);
      const ladder = ((S &amp;&amp; S.rule &amp;&amp; S.rule.tiers) || []).slice().sort((a, b) =&gt; a.minUsd - b.minUsd).filter((t) =&gt; !t.vip);
      if (ladder.length) $(&#34;p-counts&#34;).textContent = &#34;: &#34; + ladder.map((t) =&gt; `${t.maxReceiptsPerDay} on ${t.label}`).join(&#34;, &#34;);
      $(&#34;perks-floor&#34;).textContent = `For a lock worth ${usd0(L.perks.minUsd)} or more${floorTier ? ` · ${floorTier.label} and up` : &#34;&#34;}. Below the floor a lock still counts toward your tier and keeps its price.`;
    }    $(&#34;min-tokens&#34;).textContent = int(minTokens);
    $(&#34;px&#34;).textContent = (enabled ? &#34;&#34; : &#34;Locking is switched off right now · &#34;) + &#34;$RECEIPT is &#34; + px6(price) + &#34; today · terms and rates are read live&#34;;

    // 2 · the comparison: one column per term. The rows that matter are the
    // tokens each rung takes, because that is what a longer lock buys.
    const ladderTiers = ((S &amp;&amp; S.rule &amp;&amp; S.rule.tiers) || []).filter((t) =&gt; t.minUsd &gt; 0).sort((a, b) =&gt; a.minUsd - b.minUsd);
    const isBest = (t) =&gt; t === best &amp;&amp; !flat;
    const col = (t, inner, cls = &#34;&#34;) =&gt; `&lt;td class=&#34;${isBest(t) ? &#34;best &#34; : &#34;&#34;}${cls}&#34;&gt;${inner}&lt;/td&gt;`;
    $(&#34;cmp-head&#34;).innerHTML = `&lt;tr&gt;&lt;th&gt;&lt;/th&gt;${terms.map((t) =&gt; `&lt;th class=&#34;${isBest(t) ? &#34;best&#34; : &#34;&#34;}&#34;&gt;${days(t.days)}&lt;small&gt;${isBest(t) ? &#34;best rate&#34; : t.creditPercent === 100 ? &#34;full value&#34; : &#34;+&#34; + (t.creditPercent - 100) + &#34;%&#34;}&lt;/small&gt;&lt;/th&gt;`).join(&#34;&#34;)}&lt;/tr&gt;`;
    const rows = [];
    rows.push(`&lt;tr&gt;&lt;td&gt;&lt;b&gt;Every token counts as&lt;/b&gt;&lt;/td&gt;${terms.map((t) =&gt; col(t, &#34;×&#34; + mult(t))).join(&#34;&#34;)}&lt;/tr&gt;`);
    rows.push(`&lt;tr&gt;&lt;td&gt;&lt;b&gt;Price floor held for&lt;/b&gt;&lt;/td&gt;${terms.map((t) =&gt; col(t, days(t.days))).join(&#34;&#34;)}&lt;/tr&gt;`);
    rows.push(`&lt;tr&gt;&lt;td&gt;&lt;b&gt;${int(EX_TOKENS)} locked counts as&lt;/b&gt;&lt;small style=&#34;display:block&#34;&gt;at today&#39;s price&lt;/small&gt;&lt;/td&gt;${terms.map((t) =&gt; col(t, usd0(EX_TOKENS * price * t.creditPercent / 100), t.creditPercent &gt; terms[0].creditPercent ? &#34;up&#34; : &#34;&#34;)).join(&#34;&#34;)}&lt;/tr&gt;`);
    if (ladderTiers.length &amp;&amp; price &gt; 0) {
      rows.push(`&lt;tr class=&#34;sec&#34;&gt;&lt;td&gt;$RECEIPT it takes to reach&lt;/td&gt;${terms.map((t) =&gt; col(t, &#34;&#34;)).join(&#34;&#34;)}&lt;/tr&gt;`);
      for (const tier of ladderTiers) {
        rows.push(`&lt;tr&gt;&lt;td&gt;&lt;span class=&#34;pill ${tier.name}&#34;&gt;${tier.label}&lt;/span&gt; ${usd0(tier.minUsd)}&lt;/td&gt;${terms.map((t) =&gt; {
          const need = Math.ceil(tier.minUsd / (price * t.creditPercent / 100));
          const less = Math.ceil(tier.minUsd / price) - need;
          return col(t, int(need) + (less &gt; 0 ? `&lt;small&gt;${int(less)} fewer&lt;/small&gt;` : &#34;&#34;), less &gt; 0 ? &#34;up&#34; : &#34;&#34;);
        }).join(&#34;&#34;)}&lt;/tr&gt;`);
      }
    }
    rows.push(`&lt;tr class=&#34;sec&#34;&gt;&lt;td&gt;Getting it back&lt;/td&gt;${terms.map((t) =&gt; col(t, &#34;&#34;)).join(&#34;&#34;)}&lt;/tr&gt;`);
    rows.push(`&lt;tr&gt;&lt;td&gt;&lt;b&gt;After the term&lt;/b&gt;&lt;/td&gt;${terms.map((t) =&gt; col(t, &#34;all of it&#34;)).join(&#34;&#34;)}&lt;/tr&gt;`);
    rows.push(`&lt;tr&gt;&lt;td&gt;&lt;b&gt;Before the term ends&lt;/b&gt;&lt;small style=&#34;display:block&#34;&gt;the cashback earned stays yours&lt;/small&gt;&lt;/td&gt;${terms.map((t) =&gt; col(t, fee &gt; 0 ? fee + &#34;% fee&#34; : &#34;all of it&#34;)).join(&#34;&#34;)}&lt;/tr&gt;`);
    $(&#34;cmp&#34;).innerHTML = rows.join(&#34;&#34;);

    // 3 · the floor: the price falls a third after locking
    const fallen = price * 2 / 3;
    $(&#34;ex3-lockedm&#34;).textContent = `Locked ${days(best.days)} at ${px6(price)}`;
    $(&#34;ex3-locked&#34;).textContent = int(EX_TOKENS) + &#34; $RECEIPT&#34;;
    $(&#34;ex3-now&#34;).textContent = px6(fallen);
    $(&#34;ex3-hold&#34;).textContent = usd(EX_TOKENS * fallen);
    $(&#34;ex3-lock&#34;).textContent = usd(EX_TOKENS * price * best.creditPercent / 100);
    document.querySelector(&#34;#ex3-lock&#34;).previousElementSibling.textContent = best.creditPercent === 100 ? &#34;Locked · lock price&#34; : `Locked · lock price × ${best.creditPercent}%`;

    // 4 · early unlock: the fee, if there is one, and nothing else. Cashback
    // earned while locked is never taken back.
    const earned = 50;
    const feeTokens = EX_TOKENS * fee / 100;
    $(&#34;ex4-locked&#34;).textContent = int(EX_TOKENS) + &#34; $RECEIPT&#34;;
    $(&#34;ex4-earned&#34;).textContent = usd(earned) + &#34; · stays yours&#34;;
    $(&#34;ex4-px&#34;).textContent = px6(price);
    $(&#34;ex4-feem&#34;).textContent = fee &gt; 0 ? `Early fee · ${fee}%` : &#34;Early fee&#34;;
    $(&#34;ex4-fee&#34;).textContent = fee &gt; 0 ? &#34;− &#34; + int(feeTokens) : &#34;none&#34;;
    $(&#34;ex4-back&#34;).textContent = int(EX_TOKENS - feeTokens) + &#34; $RECEIPT&#34;;
    document.querySelector(&#34;#ex4-back&#34;).parentElement.nextElementSibling.textContent = fee &gt; 0
      ? `Wait out the term instead and all ${int(EX_TOKENS)} come back, and the ${usd(earned)} of stock stays yours either way.`
      : `Early or late, all ${int(EX_TOKENS)} come back, and the ${usd(earned)} of stock stays yours.`;

    // 5 · the ladder itself, with the tokens each rung takes held vs locked
    const allTiers = ((S &amp;&amp; S.rule &amp;&amp; S.rule.tiers) || []).slice().sort((a, b) =&gt; a.minUsd - b.minUsd);
    if (allTiers.length &amp;&amp; price &gt; 0) {
      $(&#34;ladder&#34;).innerHTML = allTiers.map((t) =&gt; {
        const held = t.minUsd / price;
        const pays = `${t.percent}% back&lt;small&gt;up to ${usd0(t.maxPerReceiptUsd)} a receipt · ${usd0(t.maxPerDayUsd)} a day${t.vip ? &#34; · VIP&#34; : &#34;&#34;}&lt;/small&gt;`;
        const free = t.minUsd === 0;
        return `&lt;tr&gt;&lt;td class=&#34;t&#34;&gt;&lt;span class=&#34;pill ${t.name}&#34;&gt;${t.label}&lt;/span&gt;&lt;/td&gt;&lt;td class=&#34;p&#34;&gt;${pays}&lt;/td&gt;&lt;td class=&#34;n&#34; data-l=&#34;Needs&#34;&gt;${free ? &#34;—&#34; : usd0(t.minUsd)}&lt;/td&gt;&lt;td class=&#34;n&#34; data-l=&#34;$RECEIPT today&#34;&gt;${free ? &#34;any wallet&#34; : int(Math.ceil(held))}&lt;/td&gt;&lt;/tr&gt;`;
      }).join(&#34;&#34;);
    } else {
      $(&#34;ladder&#34;).innerHTML = `&lt;tr&gt;&lt;td colspan=&#34;4&#34; style=&#34;color:var(--ink-3)&#34;&gt;The ladder could not be read right now. See &lt;a href=&#34;/tiers&#34;&gt;how tiers work&lt;/a&gt;.&lt;/td&gt;&lt;/tr&gt;`;
    }

    if (S &amp;&amp; S.rule &amp;&amp; Number.isFinite(S.rule.heldStockTierPercent)) $(&#34;t-stock&#34;).textContent = S.rule.heldStockTierPercent + &#34;%&#34;;
  });
    </script>
  </body>
</html>
