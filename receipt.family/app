  /* receipt rows: the same markup on Home, Receipts and the phone */
  .rc { position:relative; display:grid; grid-template-columns:auto minmax(0,1fr) minmax(0,auto); gap:2px 12px; align-items:center; padding:11px 0; border-top:1px solid var(--hair); font:500 12px/1.5 var(--mono); cursor:pointer; }
