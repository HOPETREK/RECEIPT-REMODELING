// ---- Invite ------------------------------------------------------------
// Handlers are bound inside the loader, not at parse time: every control here
// lives in markup declared after this script, and $("id").onclick on a node
// that does not exist yet throws and takes the rest of the file with it.
let inviteBound = false;

async function loadInvite() {
  if (!wallet) return;
  try {
    const r = await fetch(`${API}/api/receipts/referrals/${wallet}?token=${encodeURIComponent(token || "")}`);
    if (!r.ok) return;
    const d = await r.json();

    const code = d.code || "";
    const link = code ? `${location.origin}/app?ref=${encodeURIComponent(code)}` : "—";
    $("iv-link").value = link;
    $("iv-nocode").hidden = Boolean(code);
    $("iv-copy").disabled = !code;
    if (!$("iv-code").value) $("iv-code").value = code;

    $("iv-earned").textContent = money(d.earnedUsd || 0);
    $("iv-joined").textContent = String(d.joined ?? 0);
    $("iv-active").textContent = String(d.active ?? 0);
    $("iv-pct").textContent = String(d.percent ?? 10);
    for (const el of document.querySelectorAll(".iv-pct")) el.textContent = String(d.percent ?? 10);
    // Already joined on somebody's code: say whose and how long is left,
    // rather than offering a box that can only ever be refused.
    const joinedWith = d.joinedWith;
    $("iv-joined-with").hidden = !joinedWith;
    $("iv-claim-box").hidden = Boolean(joinedWith);
    if (joinedWith) {
      $("iv-joined-with").textContent = d.daysLeft > 0
        ? `You joined on ${joinedWith}'s code. They take ${d.percent}% of what you earn for ${d.daysLeft} more day${d.daysLeft === 1 ? "" : "s"}.`
        : `You joined on ${joinedWith}'s code. Their ${d.days} days are up — you keep everything you earn.`;
    }
    $("iv-days").textContent = String(d.days ?? 90);
    for (const el of document.querySelectorAll(".iv-days")) el.textContent = String(d.days ?? 90);

    if (!inviteBound) {
      inviteBound = true;
      $("iv-copy").onclick = async () => {
        const v = $("iv-link").value;
        if (!v || v === "—") return;
        try { await navigator.clipboard.writeText(v); }
        catch { $("iv-link").select(); document.execCommand("copy"); }
        $("iv-copied").hidden = false;
        setTimeout(() => { $("iv-copied").hidden = true; }, 1800);
      };
      $("iv-claim").onclick = async () => {
        const msg = $("iv-claim-msg");
        const code = $("iv-their").value.trim();
        if (!code) return;
        $("iv-claim").disabled = true;
        try {
          const res = await fetch(`${API}/api/receipts/referrals/claim`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, code }),
          });
          const body = await res.json().catch(() => ({}));
          msg.hidden = false;
          msg.textContent = res.ok ? "Done — you joined on that code." : (body.message || "Could not use that code.");
          if (res.ok) loadInvite();
        } catch {
          msg.hidden = false;
          msg.textContent = "Could not reach the server. Try again.";
        } finally {
          $("iv-claim").disabled = false;
        }
      };
      $("iv-save").onclick = async () => {
        const msg = $("iv-msg");
        const value = $("iv-code").value.trim();
        if (!value) return;
        $("iv-save").disabled = true;
        try {
          const res = await fetch(`${API}/api/profile/referral-code`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, code: value }),
          });
          const body = await res.json().catch(() => ({}));
          msg.hidden = false;
          // The server's message says what to do about it; it is written for
          // the person, so show it rather than a code of our own.
          msg.textContent = res.ok ? "Saved. That is your link now." : (body.message || "Could not save that code.");
          if (res.ok) loadInvite();
        } catch {
          msg.hidden = false;
          msg.textContent = "Could not reach the server. Try again.";
        } finally {
          $("iv-save").disabled = false;
        }
      };
    }
  } catch {}
}

async function loadStocks() {
  const body = $("st-body");
  // Someone can land straight on this tab, so it cannot depend on Home having
  // drawn first. Fetch what is missing, then render from the same numbers.
  if (wallet && !renderPortfolio.last) {
    body.innerHTML = `<div class="empty">Loading…</div>`;
    try { await Promise.all([loadRewards(), STAKE ? null : lockInit()]); } catch {}
  }
  if (!wallet && !DEMO) {
    body.innerHTML = `<div class="card"><h3 class="ct">Sign in to see your stocks.</h3><p class="status" style="margin-top:0">Every receipt pays out in the stock of the brand on it. They land here.</p></div>`;
    return;
  }
  const p = renderPortfolio.last || {};
  const owned = (p.holdings || []).filter((h) => Number(h.shares) > 0);
  const pending = renderPortfolio.pending || [];
  const stockUsd = owned.reduce((a, h) => a + (Number(h.valueUsd) || 0), 0);
  const heldUsd = renderPortfolio.heldUsd || 0;
  const lockedUsd = STAKE && STAKE.stakes && STAKE.priceUsd
    ? STAKE.stakes.filter((x) => x.status === "locked").reduce((a, x) => a + Number(x.tokens) * STAKE.priceUsd, 0)
    : 0;
  const everything = stockUsd + heldUsd + lockedUsd;

  // Locks, live and finished. The unstake button is the same one the Lock
  // screen uses, so there is one path that returns tokens, not two.
  const stakes = (STAKE && STAKE.stakes) || [];
  // 'expired' means the term ran out with the tokens still in the treasury —
  // it is not finished, it is waiting to be claimed, and it still counts
  // toward the tier. It belongs beside the live locks with a button on it.
  const holdsTokens = (x) => x.status === "locked" || x.status === "expired";
  // A finished term pays the unlock fee from a day an operator sets, so the
  // server is the only thing that knows. Never guess it from the clock.
  const expiredPays = Boolean(STAKE && STAKE.expiredFeeDue);
  const live = stakes.filter(holdsTokens);
  const done = stakes.filter((x) => !holdsTokens(x));
  const stakeCard = (x) => {
    const tokens = Math.floor(Number(x.tokens)).toLocaleString("en-US");
    const worth = STAKE && STAKE.priceUsd ? Number(x.tokens) * STAKE.priceUsd : null;
    const earlyNow = Date.now() < new Date(x.unlocksAt).getTime();
    const feePc = STAKE ? Number(STAKE.earlyFeePercent) || 0 : 0;
    const state = x.status === "locked"
      ? (earlyNow ? `Staked until ${new Date(x.unlocksAt).toLocaleDateString("en-US", { month: "short", day: "numeric" })} · unstake any time${feePc > 0 ? "" : ", no fee"}` : "Term is up · unstake any time")
      : x.status === "expired" ? (expiredPays && feePc > 0 ? `Term is up · ${feePc}% to unstake` : "Term is up · unstake any time, no fee")
      : x.status === "returned" ? `Returned${x.early ? ` early${Number(x.feePercent) > 0 ? ` · ${x.feePercent}% fee` : ""}` : ""}`
      : x.status === "failed" ? "Return failed · we are looking at it" : "On its way back";
    return `<div class="card" style="padding:14px 15px${holdsTokens(x) ? "" : ";opacity:.62"}">
      <div style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center">
        <div style="min-width:0">
          <b style="display:block;font:700 15.5px/1.2 var(--display);letter-spacing:-.02em">${tokens} $RECEIPT</b>
          <span class="status" style="display:block;margin-top:3px">${x.termDays} day${x.termDays === 1 ? "" : "s"} · ${esc(state)}</span>
        </div>
        ${worth != null ? `<b style="font:700 16px/1 var(--mono);white-space:nowrap">${money(worth)}</b>` : ""}
      </div>
      ${holdsTokens(x) ? `<button class="btn" type="button" data-unlock="${x.id}" style="width:100%;margin-top:12px">${feePc > 0 && ((x.status === "locked" && earlyNow) || (x.status === "expired" && expiredPays)) ? `Unstake${x.status === "locked" ? " early" : ""} · ${feePc}% fee` : "Unstake"}</button>` : ""}
    </div>`;
  };
  const stakeRows = (live.length ? `<div class="k" style="margin:20px 0 10px">Staked</div><div style="display:grid;gap:10px">${live.map(stakeCard).join("")}</div>` : "")
    + (done.length ? `<div class="k" style="margin:20px 0 10px">Finished locks</div><div style="display:grid;gap:10px">${done.map(stakeCard).join("")}</div>` : "")
    + (!live.length && STAKE && STAKE.enabled ? `<div class="card" style="margin-top:20px"><h3 class="ct">Nothing staked right now.</h3><p class="status" style="margin-top:0">Lock $RECEIPT to count more toward your tier. It comes back when the term is up.</p><button class="btn" type="button" data-go-lock style="margin-top:12px;width:auto">Lock $RECEIPT →</button></div>` : "");

  const line = (label, value, note) => value > 0
    ? `<div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:9px 0;border-bottom:1px dashed var(--hair)">
         <span><b style="font:600 14px/1.3 var(--display)">${esc(label)}</b>${note ? `<span class="status" style="display:block;margin-top:2px">${esc(note)}</span>` : ""}</span>
         <b style="font:700 15px/1 var(--mono);white-space:nowrap">${money(value)}</b>
       </div>` : "";

  const rows = owned.sort((a, b) => (b.valueUsd ?? 0) - (a.valueUsd ?? 0)).map((h) => `
    <div class="card" style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:14px 15px">
      <div style="min-width:0">
        <b style="display:block;font:700 15.5px/1.2 var(--display);letter-spacing:-.02em">${esc(h.company)}</b>
        <span class="status" style="display:block;margin-top:3px">${esc(h.ticker)}${h.chain === "solana" ? " · Solana" : ""} · ${Number(h.shares).toFixed(4)} shares${h.priceUsd ? ` at $${Number(h.priceUsd).toFixed(2)}` : ""}</span>
      </div>
      <b style="font:700 16px/1 var(--mono);white-space:nowrap">${money(h.valueUsd ?? 0)}</b>
    </div>`).join("");

  const onTheWay = pending.map((x) => `
    <div class="card" style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:14px 15px;opacity:.7">
      <div style="min-width:0">
        <b style="display:block;font:700 15.5px/1.2 var(--display);letter-spacing:-.02em">${esc(x.company || x.merchant || "Receipt")}</b>
        <span class="status" style="display:block;margin-top:3px">${x.ticker ? esc(x.ticker) : "being read"} · on its way</span>
      </div>
      <b style="font:700 15px/1 var(--mono);white-space:nowrap">${x.reward_usd != null ? money(x.reward_usd) : "—"}</b>
    </div>`).join("");

  const nativeUsd = BALANCE && BALANCE.native && BALANCE.native.valueUsd ? Number(BALANCE.native.valueUsd) : 0;
  const nativeAmt = BALANCE && BALANCE.native ? Number(BALANCE.native.amount) : 0;
  const all = stockUsd + heldUsd + lockedUsd + nativeUsd;

  body.innerHTML = `
    <button class="card" id="st-total" type="button" style="width:100%;text-align:left;margin-bottom:16px;cursor:pointer;border:1px solid var(--hair)">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px">
        <div class="k">Everything here</div>
        <span class="status" style="margin:0">tap for the breakdown ›</span>
      </div>
      <b style="display:block;font:800 36px/1 var(--display);letter-spacing:-.04em;margin:10px 0 8px">${money(all)}</b>
      <span class="status" style="display:block;margin:0">${[
        stockUsd ? `${money(stockUsd)} stock` : "",
        nativeUsd ? `${money(nativeUsd)} ETH` : "",
        heldUsd ? `${money(heldUsd)} $RECEIPT` : "",
        lockedUsd ? `${money(lockedUsd)} locked` : "",
      ].filter(Boolean).join(" · ") || "nothing yet"}</span>
    </button>
    ${rows ? `<div class="k" style="margin:20px 0 10px">Your shares</div><div style="display:grid;gap:10px">${rows}</div>` : ""}
    ${onTheWay ? `<div class="k" style="margin:20px 0 10px">On its way</div><div style="display:grid;gap:10px">${onTheWay}</div>` : ""}
    ${!rows && !onTheWay ? `<div class="card" style="margin-top:20px"><h3 class="ct">No stock yet.</h3><p class="status" style="margin-top:0">Scan a receipt and the brand's stock lands here, usually within a few minutes.</p><button class="btn" type="button" data-go="scan" style="margin-top:12px;width:auto">Scan a receipt →</button></div>` : ""}
    <div id="st-activity"></div>
    ${stakeRows}`;

  // Every movement of stock, newest first. The list above is what is held now;
  // this is how it got there, and it is the thing someone reads when a number
  // is smaller than they expected — the withdrawal is usually the answer.
  loadStockActivity();

// The breakdown, on a tap. Four things a wallet holds here, each said once.
  const total = $("st-total");
  if (total) total.onclick = () => {
    const row = (label, value, note) => `<div style="display:flex;justify-content:space-between;align-items:baseline;gap:14px;padding:12px 0;border-bottom:1px dashed var(--hair)">
