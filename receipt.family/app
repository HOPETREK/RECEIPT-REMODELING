// ---- Home: the streak, the chart, earned by brand. All read off the receipts already loaded. ----
let CHART_RANGE = 30;
const rewardOf = (x) => Number(x.reward_paid_usd ?? x.reward_usd ?? 0);
function renderHome(rows) {
  const good = rows.filter((x) => x.status !== "rejected" && x.reward_status !== "cancelled");
  // Streak: consecutive days with a receipt that went through, ending today or yesterday.
  const days = new Set(good.map((x) => new Date(x.created_at).toDateString()));
  let streak = 0; const d = new Date(); if (!days.has(d.toDateString())) d.setDate(d.getDate() - 1);
  while (days.has(d.toDateString())) { streak++; d.setDate(d.getDate() - 1); }
  const st = $("streak"); if (st) st.textContent = streak ? `${streak}-day streak · keep it going` : "No streak yet";
  const st2 = $("streak2"); if (st2) st2.textContent = streak ? `${streak}-day streak` : "No streak yet";
  // Earned by brand.
  const by = {};
  for (const x of good) { if (!x.ticker) continue; by[x.ticker] = by[x.ticker] || { usd: 0, name: x.company || x.merchant || x.ticker }; by[x.ticker].usd += rewardOf(x); }
  const list = Object.entries(by).filter(([, v]) => v.usd > 0).sort((a, b) => b[1].usd - a[1].usd).slice(0, 5);
  const total = list.reduce((s, [, v]) => s + v.usd, 0), top = list[0] ? list[0][1].usd : 1;
  const bb = $("by-brand");
  if (bb) bb.innerHTML = list.length === 0 ? `<div class="empty">Nothing yet. Every brand that pays out shows up here.</div>`
    : list.map(([tk, v]) => `<div class="bb" ${brandStyle(tk)}><span class="tile">${esc(tk)}</span><span class="bb-m"><span class="bb-t"><span>${esc(v.name)}</span><span>${money(v.usd)}</span></span><span class="bb-bar"><i style="width:${Math.round(v.usd / top * 100)}%"></i></span></span><span class="bb-s">${total ? Math.round(v.usd / total * 100) : 0}%</span></div>`).join("");
  // The past month, under the balance.
  const since = Date.now() - 30 * 86400000;
  const month = good.filter((x) => new Date(x.created_at) >= since);
  const mUsd = month.reduce((s, x) => s + rewardOf(x), 0);
  const chg = $("pv-chg");
  if (chg) { chg.hidden = month.length === 0; chg.innerHTML = `+${money(mUsd)} <span>past month · ${month.length} receipt${month.length === 1 ? "" : "s"}</span>`; }
  renderChart.rows = good;
  renderChart();
}
function renderChart() {
  const good = renderChart.rows || [];
  const line = $("chart-line"), area = $("chart-area"); if (!line || !area) return;
  const pts0 = good.map((x) => [new Date(x.created_at).getTime(), rewardOf(x)]).sort((a, b) => a[0] - b[0]);
  const now = Date.now();
  const from = CHART_RANGE ? now - CHART_RANGE * 86400000 : Math.min(pts0.length ? pts0[0][0] : now, now - 7 * 86400000);
  // What this account had earned, all time, at each point across the range.
  const N = 40, vals = [];
  for (let i = 0; i <= N; i++) { const t = from + (now - from) * i / N; vals.push(pts0.reduce((s, p) => p[0] <= t ? s + p[1] : s, 0)); }
  const mn = Math.min(...vals), mx = Math.max(...vals);
  const pts = vals.map((v, i) => [i / N * 600, mx === mn ? 90 : 160 - (v - mn) / (mx - mn) * 140]);
  const path = "M" + pts.map((q) => q[0].toFixed(1) + " " + q[1].toFixed(1)).join(" L");
  line.setAttribute("d", path); area.setAttribute("d", path + " L600 170 L0 170 Z");
  // Nothing earned at all: no chart, a short line and the way to the scanner.
  const card = document.querySelector(".bal-card"), empty = $("chart-empty");
  const nothing = !good.some((x) => rewardOf(x) > 0);
  if (card) card.classList.toggle("is-empty", nothing);
  if (empty) empty.hidden = !nothing;
  const fmt = (t) => new Date(t).toLocaleDateString("en-US", { month: "short", day: "numeric" });
  const ax = $("chart-axis"); if (ax) ax.innerHTML = [from, (from + now) / 2, now].map((t) => `<span>${fmt(t)}</span>`).join("");
}
for (const b of document.querySelectorAll("#chart-range [data-range]")) b.onclick = () => {
  for (const o of document.querySelectorAll("#chart-range [data-range]")) o.classList.toggle("on", o === b);
  CHART_RANGE = Number(b.dataset.range); renderChart();
};

