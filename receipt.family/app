      <button type="button" data-tab="invite"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M19 8v6M22 11h-6"/></svg>Invite</button>
      <button type="button" data-tab="support"><svg viewBox="0 0 24 24"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM9.5 9.5a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5M12 17h.01"/></svg>Help</button>
    </nav>
    <div class="spacer"></div>
    <div class="m-wallet t-paper" id="m-wallet">
      <div class="mw-top"><b id="m-rtier">Paper</b><span><span class="mw-boost" id="m-boost" hidden>Boosted · </span><span id="m-rpct">0%</span> back</span></div>
      <div class="bar"><i id="m-rfill"></i></div>
      <div class="status" id="m-rnote"></div>
    </div>
    <a class="user" id="who" href="#profile" data-go="profile" title="Your profile">
      <span class="av" id="rail-av">?</span>
      <span><b id="wshort"></b><small>Your profile</small></span>
      <img id="wav" alt="" hidden>
    </a>
    <script>
    // The rail as it was last drawn, put back before the first paint. Its card
    // and name come from the network, and waiting for them made the card grow
    // and jump, and the name read "?" and a bare address, on every load.
    (() => {
      if (/[?&]demo=/.test(location.search)) return;
      const side = document.currentScript.closest(".side"), q = (s) => side.querySelector(s);
      const part = { label: ".mw-top b", pct: ".mw-top > span > span:last-child", note: ".m-wallet .status", av: ".user .av", name: ".user b" };
      let wallet = null;
      try { wallet = JSON.parse(localStorage.getItem("receipt.session") || "null").wallet; } catch {}
      if (!wallet) return;
      try {
        const c = JSON.parse(localStorage.getItem("receipt.rail") || "null");
        if (c && c.w === wallet) {
          q(".m-wallet").className = c.cls; q(".m-wallet").hidden = false;
          for (const k in part) q(part[k]).innerHTML = c[k];
          q(".mw-boost").hidden = !c.boost; q(".m-wallet .bar i").style.width = c.fill;
          side.dataset.rail = wallet;
        }
      } catch {}
      let queued = false;
      new MutationObserver(() => {
        if (queued) return; queued = true;
        setTimeout(() => {
          queued = false;
          const card = q(".m-wallet"); if (card.hidden) return;
          const c = { w: wallet, cls: card.className, boost: !q(".mw-boost").hidden, fill: q(".m-wallet .bar i").style.width };
          for (const k in part) c[k] = q(part[k]).innerHTML;
          try { localStorage.setItem("receipt.rail", JSON.stringify(c)); } catch {}
        });
      }).observe(side, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ["class", "style", "hidden", "src"] });
    })();
    </script>
    <!-- Rewards in: what this wallet is paid in. Beside Appearance because it
         is the same kind of setting — always to hand, on every screen, rather
