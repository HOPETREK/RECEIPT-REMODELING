  .wpick-c { width:100%; max-width:320px; background:var(--paper); border-radius:14px; padding:18px; }
  .wpick-h { font:700 14px/1.3 var(--display); letter-spacing:-.02em; margin-bottom:12px; }
  .wpick-c button { display:block; width:100%; margin-top:8px; padding:12px; cursor:pointer; border:1px solid var(--hair2); background:transparent; color:var(--ink); border-radius:10px; text-align:left; font:600 12px/1 var(--mono); }
  .wpick-c button:hover { background:var(--ink); color:var(--bg); border-color:var(--ink); }
  .wpick-c .wpick-x { text-align:center; border:0; color:var(--faint); font-weight:500; }
  .landed { position:fixed; left:50%; bottom:calc(84px + env(safe-area-inset-bottom)); transform:translate(-50%,16px); z-index:60; background:var(--ink); color:var(--bg); padding:12px 18px; border-radius:999px; pointer-events:none;
    font:600 13px/1 var(--mono); box-shadow:0 18px 40px -14px rgba(0,0,0,.6); opacity:0; transition:opacity .32s var(--ease), transform .32s var(--ease); white-space:nowrap; max-width:92vw; overflow:hidden; text-overflow:ellipsis; }
