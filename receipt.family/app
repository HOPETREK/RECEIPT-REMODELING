    body.dash nav.tabbar.phone { position:fixed; left:0; right:0; bottom:0; z-index:55; display:grid; grid-template-columns:repeat(5,1fr); align-items:end; padding:10px 8px calc(10px + env(safe-area-inset-bottom)); background:var(--paper); border-top:1px solid var(--hair); }
    nav.tabbar.phone button, nav.tabbar.phone a { display:flex; flex-direction:column; align-items:center; gap:5px; padding:0; border:0; background:none; color:var(--faint); text-decoration:none; font:600 9px/1 var(--mono); letter-spacing:.1em; text-transform:uppercase; cursor:pointer; }
    nav.tabbar.phone svg { width:22px; height:22px; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
    nav.tabbar.phone .on { color:var(--ink); }
