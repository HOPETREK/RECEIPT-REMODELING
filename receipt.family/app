// The phone's two history tabs. Receipts is what was sent and what came back;
// Transactions is what actually moved on chain, which is the same story told
// from the wallet's side — a delivered receipt is a transfer with a hash.
function renderPhoneHistory(rows) {
  const box = $("m-receipts"); if (!box) return;
  const top = rows.slice(0, 8);
  box.innerHTML = top.length === 0
    ? `<div class="empty">Your receipts will show here as they are read, approved and paid.</div>`
    : top.map((x) => {
      const [cls, label] = statusOf(x);
      const paid = x.reward_paid_usd ?? x.reward_usd;
      return `<div class="rc ${brandCls(x.ticker)}" ${brandStyle(x.ticker)} data-tk="${esc(x.ticker || "")}" data-rc="${esc(String(x.id))}" role="button" tabindex="0">
        <div><div class="t">${esc(x.merchant || x.company || "Receipt")}</div>
          <div class="m">${x.total_usd != null ? money(x.total_usd) + " · " : ""}${new Date(x.created_at).toLocaleDateString("en-US", { month: "short", day: "numeric" })}</div></div>
        <div class="r">${paid != null && cls !== "no" ? `<b>${money(paid)}${x.ticker ? ` in ${esc(x.ticker)}` : ""}</b><br>` : ""}<span class="pill ${cls}">${esc(label)}</span></div>
      </div>`;
    }).join("");
  // A statement, not a list: every receipt that moved money, newest first,
  // grouped under the day it happened and carrying the id you can quote at us.
  const moves = $("m-moves"); if (!moves) return;
  const moved = rows.filter((x) => x.status !== "rejected")
    .sort((a, b) => new Date(b.delivered_at || b.created_at) - new Date(a.delivered_at || a.created_at));
  if (moved.length === 0) { moves.innerHTML = `<div class="empty">Nothing has moved yet.</div>`; return; }
  // "2 hours ago" is what a transactions list says, because how long ago is the
  // question being asked; the date takes over once that stops being useful.
  const ago = (d) => {
    const m = Math.round((Date.now() - new Date(d)) / 60000);
    if (m < 1) return "just now";
    if (m < 60) return `${m} min ago`;
    const h = Math.round(m / 60);
    if (h < 24) return `${h} hour${h > 1 ? "s" : ""} ago`;
    const days = Math.round(h / 24);
    if (days <= 6) return `${days} day${days > 1 ? "s" : ""} ago`;
    return new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric" });
  };
  const startOfDay = (d) => { const t = new Date(d); t.setHours(0, 0, 0, 0); return t.getTime(); };
  const dayOf = (x) => {
    const when = x.delivered_at || x.created_at;
