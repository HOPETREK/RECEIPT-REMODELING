/** The wallet's stock movements: earned, withdrawn, bought. */
async function loadStockActivity() {
  const box = $("st-activity");
  if (!box) return;
  if (DEMO) return demoStockActivity(box);
  if (!wallet) { box.innerHTML = ""; return; }
  try {
    const r = await fetch(`${API}/api/receipts/stock-activity/${wallet}?limit=40&token=${encodeURIComponent(token || "")}`);
    if (!r.ok) throw new Error("http " + r.status);
    const j = await r.json();
    drawStockActivity(box, j.activity || [], j.explorerUrl);
  } catch { box.innerHTML = ""; }
}

const ACT = {
  earned:    { label: "Earned",    sign: "+", cls: "up" },
  bought:    { label: "Bought",    sign: "+", cls: "up" },
  withdrawn: { label: "Withdrawn", sign: "−", cls: "down" },
};

function drawStockActivity(box, list, explorerUrl) {
  // An empty section with no words in it reads as a broken screen. Say why it
  // is empty instead: a wallet that has never earned stock has no movements,
  // and that is a fact worth stating rather than a gap to leave.
  if (!list.length) {
    box.innerHTML = `<div class="k" style="margin:20px 0 10px">Stock activity</div>
      <div class="card"><p class="status" style="margin:0">Nothing yet. Every share earned, bought or withdrawn shows up here.</p></div>
      <button class="btn ghost sm" type="button" data-go="txns" style="width:auto;margin-top:12px">All transactions →</button>`;
    return;
  }
  const when = (iso) => {
    const d = new Date(iso), now = Date.now(), s = (now - d.getTime()) / 1000;
    if (s < 3600) return Math.max(1, Math.round(s / 60)) + "m ago";
    if (s < 86400) return Math.round(s / 3600) + "h ago";
    return d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
  };
  const sh = (n) => n === null || n === undefined ? "" : Number(n).toFixed(Number(n) >= 1 ? 3 : 4);
  const rows = list.map((a) => {
    const m = ACT[a.kind] || { label: a.kind, sign: "", cls: "" };
    // A row still in flight says so; a finished one does not need to.
    const done = ["delivered", "returned", "credited", "sent"].includes(String(a.status));
    const note = [m.label, a.merchant ? esc(a.merchant) : "", done ? "" : esc(String(a.status).replace(/_/g, " "))]
      .filter(Boolean).join(" · ");
    const link = a.tx && explorerUrl
      ? `<a href="${esc(explorerUrl.replace(/\/$/, ""))}/tx/${esc(a.tx)}" target="_blank" rel="noopener" class="lnk" style="font-size:10px">tx</a>` : "";
    return `<div class="card" style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center;padding:12px 15px${done ? "" : ";opacity:.7"}">
      <div style="min-width:0">
        <b style="display:block;font:700 14.5px/1.2 var(--display);letter-spacing:-.02em">${esc(a.ticker)}</b>
        <span class="status" style="display:block;margin-top:2px">${note} · ${esc(when(a.at))} ${link}</span>
      </div>
      <b style="font:700 14px/1 var(--mono);white-space:nowrap;color:${m.cls === "down" ? "var(--soft)" : "var(--green)"}">${m.sign}${esc(sh(a.shares))}</b>
    </div>`;
  }).join("");
  box.innerHTML = `<div class="k" style="margin:20px 0 10px">Stock activity</div><div style="display:grid;gap:8px">${rows}</div>
    <button class="btn ghost sm" type="button" data-go="txns" style="width:auto;margin-top:12px">All transactions →</button>`;
}

/* ---------------- Transactions: the whole stock history, live ---------------- */

let TX = { filter: "all", rows: [], before: null, more: false, busy: false, timer: null };

/**
 * The newest page, fetched fresh. Called on open, on a filter change, and on
 * the poll — so it always replaces what is shown rather than appending, and
 * older pages are dropped. Paging forward is loadTxMore().
 */
async function loadTxns(quiet) {
  const body = $("tx-body");
  if (!body) return;
  if (DEMO) { TX.rows = demoTxRows(); TX.before = null; TX.more = false; return drawTxns(TX.rows, null); }
  if (!wallet) {
    body.innerHTML = `<div class="card"><h3 class="ct">Sign in to see your transactions.</h3><p class="status" style="margin-top:0">Every share earned, bought or withdrawn shows up here.</p></div>`;
    $("tx-more").hidden = true;
    return;
  }
  if (!quiet && !TX.rows.length) body.innerHTML = `<div class="empty">Loading…</div>`;
  try {
    const r = await fetch(`${API}/api/receipts/stock-activity/${wallet}?limit=40&token=${encodeURIComponent(token || "")}`, { cache: "no-store" });
    if (!r.ok) throw new Error("http " + r.status);
    const j = await r.json();
    TX.rows = j.activity || [];
    TX.before = j.nextBefore || null;
    TX.more = Boolean(j.nextBefore);
    drawTxns(TX.rows, j.explorerUrl);
    $("tx-live").classList.remove("stale");
  } catch {
    // A failed poll must not blank a list someone is reading.
    $("tx-live").classList.add("stale");
    if (!TX.rows.length) body.innerHTML = `<div class="empty">Couldn't load transactions. Retrying…</div>`;
  }
}

/** The next page back, appended. */
async function loadTxMore() {
  if (!wallet || DEMO || TX.busy || !TX.before) return;
  TX.busy = true;
  const btn = $("tx-more"); const was = btn.textContent; btn.textContent = "Loading…"; btn.disabled = true;
  try {
    const r = await fetch(`${API}/api/receipts/stock-activity/${wallet}?limit=40&before=${encodeURIComponent(TX.before)}&token=${encodeURIComponent(token || "")}`, { cache: "no-store" });
    if (r.ok) {
      const j = await r.json();
      TX.rows = TX.rows.concat(j.activity || []);
      TX.before = j.nextBefore || null;
      TX.more = Boolean(j.nextBefore);
      drawTxns(TX.rows, j.explorerUrl);
    }
  } catch {}
  btn.textContent = was; btn.disabled = false; TX.busy = false;
}

function drawTxns(list, explorerUrl) {
  const body = $("tx-body");
  const rows = TX.filter === "all" ? list : list.filter((x) => x.kind === TX.filter);
  $("tx-more").hidden = !TX.more || TX.filter !== "all" || DEMO;
  if (!rows.length) {
    body.innerHTML = `<div class="card"><p class="status" style="margin:0">${
      list.length ? "Nothing of that kind yet." : "No transactions yet. Scan a receipt and the first one lands here."
    }</p></div>`;
    return;
  }
  // Grouped by day, the way a statement reads.
  const dayOf = (iso) => new Date(iso).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" });
  const today = new Date().toDateString();
  const groups = [];
  for (const x of rows) {
    const d = new Date(x.at);
    const label = d.toDateString() === today ? "Today" : dayOf(x.at);
    const last = groups[groups.length - 1];
    if (last && last.label === label) last.items.push(x); else groups.push({ label, items: [x] });
  }
  const time = (iso) => new Date(iso).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" });
  const sh = (n) => n === null || n === undefined ? "" : Number(n).toFixed(Number(n) >= 1 ? 3 : 4);
  body.innerHTML = groups.map((g) => `
    <div class="k" style="margin:18px 0 8px">${esc(g.label)}</div>
    <div style="display:grid;gap:8px">${g.items.map((a) => {
      const m = ACT[a.kind] || { label: a.kind, sign: "", cls: "" };
      const done = ["delivered", "returned", "credited", "sent"].includes(String(a.status));
      const note = [m.label, a.merchant ? esc(a.merchant) : "", done ? "" : esc(String(a.status).replace(/_/g, " "))].filter(Boolean).join(" · ");
      const link = a.tx && explorerUrl
