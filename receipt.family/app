    if (diff === 0) return "Today";
    if (diff === 1) return "Yesterday";
    return new Date(when).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric" });
  };
  const days = [];
  for (const x of moved.slice(0, 30)) {
    const d = dayOf(x);
    if (!days.length || days[days.length - 1].day !== d) days.push({ day: d, items: [] });
    days[days.length - 1].items.push(x);
  }
  const explorerFor = (x) => x.chain === "solana" ? "https://solscan.io" : "https://robinhoodchain.blockscout.com";
  moves.innerHTML = days.map((g) => `
    <div class="tl-day">${esc(g.day)}</div>
    ${g.items.map((x) => {
      const settled = x.reward_status === "delivered" || x.reward_status === "held";
      const amt = x.reward_paid_usd ?? x.reward_usd;
      return `<div class="tlx ${settled ? "" : "wait"}" data-rc="${esc(String(x.id))}" role="button" tabindex="0">
