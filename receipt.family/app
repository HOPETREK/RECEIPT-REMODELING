// Poll the wallet's provider for a receipt; wallets don't expose ethers' waiters.
async function waitForTx(hash, ms = 120000) {
  const t0 = Date.now();
  while (Date.now() - t0 < ms) {
    const rc = await eth().request({ method: "eth_getTransactionReceipt", params: [hash] });
    if (rc) return rc;
    await sleep(1500);
  }
  return null;
}
