  .rc::before { content:attr(data-tk); width:34px; height:34px; border-radius:10px; display:grid; place-items:center; background:var(--c,var(--faint)); color:#fff; font:700 9px/1 var(--mono); letter-spacing:0; overflow:hidden; }
  .rc:not([data-tk])::before, .rc[data-tk=""]::before { content:"•"; background:var(--paper2); color:var(--faint); font-size:14px; }
  .rc > div:first-of-type { min-width:0; }
  .rc .t { font:700 14px/1.2 var(--display); letter-spacing:-.01em; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .rc .t .m { font:500 11px/1 var(--mono); }
  .rc .m { color:var(--soft); font-size:10.5px; margin-top:3px; }
  .rc .rc-time, .rc .rc-total { display:none; }
  .rc .r { text-align:right; white-space:nowrap; min-width:0; max-width:62%; }
  .rc .r b { display:block; font:600 12.5px/1.2 var(--mono); color:var(--green); font-variant-numeric:tabular-nums; margin-bottom:5px; }
  .rc .r b .m { display:none; }
  .rc .r > br { display:none; }
  .rc .r a.m { display:block; font-size:10px; margin-top:4px; }
  .rc .r > span.m { display:block; font-size:10px; margin-top:4px; }
  .rc.new { animation:flash 2.4s ease-out; }
  .rc.sel { background:var(--bg); border-radius:12px; padding-left:8px; padding-right:8px; margin:0 -8px; border-top-color:transparent; }
  .rc.sel + .rc { border-top-color:transparent; }
  @keyframes flash { 0%{background:var(--green3)} 100%{background:transparent} }
  #m-receipts .rc:nth-child(n+5) { display:none; }
