  .tl-stats b { display:block; font:800 22px/1 var(--display); letter-spacing:-.04em; margin-top:6px; }
  .tl-stats b.hero { font-size:34px; letter-spacing:-.05em; }
  .tl-need { margin-top:22px; padding-top:14px; border-top:1px solid var(--rim,rgba(0,0,0,.14)); font:500 11px/1.5 var(--mono); opacity:.9; }
  .tl-need b { font-weight:600; }
  .tl-sp { flex:1; }
  .tn .row span b { color:var(--faint); font-weight:500; }
  .tn .row span i { font-style:normal; color:var(--faint); margin:0 4px; }
  .tn .row span em { font-style:normal; color:var(--green); font-weight:600; }
  .good { font:500 12.5px/1.7 var(--mono); color:var(--soft); }

  /* ---- move ---- */
  .mv-grid { display:grid; grid-template-columns:480px minmax(0,1fr); gap:20px; align-items:start; }
  .mv-grid > * { min-width:0; }
  .mv-tabs { display:flex; background:var(--paper2); border-radius:10px; padding:4px; margin-bottom:18px; }
