<!-- ============ signed out ============ -->
<section id="gate">
  <div class="gate-l">
    <a class="logo brand" href="/"><img src="/brand/png/glyph-black.png" alt="">Receipt</a>
    <a class="gate-logo" href="/" hidden></a>
    <div class="gate-body">
      <div class="k green" id="gate-first-row"><span id="gate-first">Hold $100 of $RECEIPT and every receipt pays 2% back</span></div>
      <h1 class="gate-h">Scan a receipt.<br><span class="em">Own</span> the brand.</h1>
      <p class="lede">Sign in with your email. No account to set up, nothing to download.</p>

      <!-- shown only when scanning is switched off in the console -->
      <div class="card" id="soon" hidden style="margin-bottom:16px">
        <div class="k">Not open yet</div>
        <h3 class="ct">Going live very soon.</h3>
        <p class="status" style="margin-top:0">The scanner opens right here the moment it's ready.</p>
      </div>

      <div id="step1">
        <div id="signing" role="status" aria-live="polite">
          <div class="sg-line" id="sg-text">Signing you in…</div>
          <p class="hint" id="sg-slow" hidden>Still working, this can take a few seconds. <button class="lnk" id="sg-restart" type="button">Start over</button></p>
        </div>
        <div id="email-flow">
          <div class="two io">
            <input type="text" id="email" inputmode="email" autocomplete="email" placeholder="you@email.com" />
            <button class="btn" id="email-go">Continue</button>
          </div>
          <div id="code-row" hidden style="margin-top:10px">
            <div class="two io">
              <input type="text" id="code" inputmode="numeric" autocomplete="one-time-code" placeholder="6-digit code" maxlength="6" />
              <button class="btn" id="code-go">Sign in</button>
            </div>
          </div>
        </div>
        <div class="or">or</div>
        <button class="btn ghost" id="wallet-reveal" type="button" style="margin-top:0">Continue with a crypto wallet</button>
        <div id="wallet-btns">
        <button class="btn ghost" id="connect-sol" style="margin-top:0">Continue with Phantom · Solana</button>
        <button class="btn ghost" id="connect-phantom-evm" hidden>Phantom · Ethereum</button>
        <button class="btn ghost" id="connect">Continue with MetaMask</button>
        </div>
        <p class="hint">Already use Phantom or MetaMask? Sign in with it and your stock lands there. Ethereum wallets are switched to Robinhood Chain, where $RECEIPT lives.</p>
        <div class="status" id="s1"></div>
        <button class="btn ghost" id="disconnect">Reset</button>
      </div>
    </div>
    <div class="gate-foot"><a href="/rules">Rules</a><a href="/help">Help</a><a href="/live">Live</a><a href="/proof">Proof</a></div>
  </div>
  <div class="gate-r">
