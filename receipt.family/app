  /* The sweep is the ink colour at low alpha, not white: a white shimmer on the
     dark theme's near-black card reads as a flash rather than a highlight. */
  .sk::after { content:""; position:absolute; inset:0; transform:translateX(-100%); background:linear-gradient(90deg, transparent, var(--sk-shine), transparent); animation:skShine 1.25s infinite; }
