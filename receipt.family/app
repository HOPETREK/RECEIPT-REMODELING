      ${row("ETH", nativeUsd, nativeAmt ? `${nativeAmt.toFixed(4)} ETH · pays for gas` : "none · a transaction cannot be sent")}
      ${row("$RECEIPT", heldUsd, "in this wallet, counts toward your tier")}
      ${row("Locked", lockedUsd, live.length ? `${live.length} lock${live.length === 1 ? "" : "s"} · comes back when the term is up` : "nothing locked")}
