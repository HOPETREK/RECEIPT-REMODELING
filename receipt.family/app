  .side .tabbar button, .side .tabbar a { display:flex; align-items:center; gap:12px; width:100%; min-height:42px; padding:0 12px; border:0; border-radius:10px; text-align:left; cursor:pointer; background:transparent; color:var(--soft); font:600 13.5px/1 var(--display); letter-spacing:-.01em; text-decoration:none; transition:color .15s, background .15s; }
