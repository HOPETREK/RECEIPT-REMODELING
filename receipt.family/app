  /* ---- tiers ---- */
  .ladder { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:12px; align-items:stretch; }
  @media (max-width:1400px) { .ladder { grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; } }
  /* A tier is a card you can turn over. The outer .tl-c holds the perspective,
     .tl-in is what rotates, and the two .tl-r faces sit back to back. The front
     face keeps every rule it already had, so the row looks identical until it
     is tapped. */
  .ladder { perspective:1600px; }
  /* Transactions: a live dot that goes amber when the fetch stops landing. */
  /* A wallet under the first rung has no day to spend. The card says the way
     on rather than showing a bar against a cap of zero. */
  .today.no-day .earn, .today.no-day .bar, .today.no-day .trow { display:none; }
  .today .no-day-note { display:none; }
  .today.no-day .no-day-note { display:block; }
  .today .no-day-note b { display:block; font:700 15px/1.35 var(--display); letter-spacing:-.02em; }
  .tx-live { display:inline-flex; align-items:center; gap:7px; font:500 10px/1 var(--mono);
    letter-spacing:.16em; text-transform:uppercase; color:var(--soft); white-space:nowrap; }
  .tx-live i { width:6px; height:6px; border-radius:50%; background:var(--green); display:block;
    animation:txpulse 2s ease-in-out infinite; }
  .tx-live.stale i { background:#946200; animation:none; }
  @keyframes txpulse { 0%,100%{opacity:1} 50%{opacity:.35} }
  @media (prefers-reduced-motion: reduce){ .tx-live i { animation:none } }
  .tl-c { cursor:pointer; border-radius:18px; display:flex; min-width:0; }
  .tl-c:focus-visible { outline:2px solid var(--ink); outline-offset:4px; }
  .tl-in { position:relative; flex:1; min-width:0; display:flex; transform-style:preserve-3d; transition:transform .55s cubic-bezier(.22,.7,.3,1); }
  .tl-c.flip .tl-in { transform:rotateY(180deg); }
  .tl-in > .tl-f { flex:1; min-width:0; }
  .tl-in > .tl-r { backface-visibility:hidden; -webkit-backface-visibility:hidden; }
  /* The back sits on top of the front and is turned away until the flip. */
  .tl-in > .tl-b { position:absolute; inset:0; transform:rotateY(180deg); }
  /* The hint is in flow at the end of the face, not floated over it: the
     footer text is the last flex child and an absolute hint landed on top
     of it on every card. */
  .tl-hint { display:block; margin-top:12px; font:600 8.5px/1 var(--mono);
    letter-spacing:.16em; text-transform:uppercase; opacity:.5; }
  .tl-dl { margin:24px 0 0; display:grid; gap:11px; }
  .tl-dl > div { display:flex; align-items:baseline; justify-content:space-between; gap:12px;
    padding-bottom:9px; border-bottom:1px solid var(--well,rgba(0,0,0,.12)); }
  .tl-dl dt { font:600 9.5px/1.2 var(--mono); letter-spacing:.14em; text-transform:uppercase; opacity:.72; }
  .tl-dl dd { margin:0; font:800 19px/1 var(--display); letter-spacing:-.035em; }
  .tl-dl .stk dd, .tl-dl .stk dt { opacity:1; }
  /* The row is already labelled "Staked · back"; repeating it on the value
     read as a stutter on every card. */
  /* Someone who would rather not see things move gets the flip instantly. */
  @media (prefers-reduced-motion: reduce) { .tl-in { transition:none; } }
  .tl-r { position:relative; overflow:hidden; border-radius:18px; padding:22px 20px; min-height:380px; display:flex; flex-direction:column; background:var(--mat); color:var(--ink-c); box-shadow:var(--card-sh); }
  .tl-r::before { content:""; position:absolute; inset:0; pointer-events:none; opacity:var(--sheen,0); background:linear-gradient(160deg,rgba(255,255,255,.22),rgba(255,255,255,0) 38%,rgba(0,0,0,.1) 78%,rgba(0,0,0,.18)); }
  .tl-r > * { position:relative; }
  .tl-r.on { outline:2px solid var(--ink); outline-offset:3px; }
  .tl-top { display:flex; justify-content:space-between; align-items:center; font:600 9.5px/1 var(--mono); letter-spacing:.18em; text-transform:uppercase; opacity:.85; }
  .tl-top .tl-badge { padding:4px 7px; border-radius:6px; background:var(--well,rgba(0,0,0,.14)); font-size:9px; letter-spacing:.1em; opacity:1; }
  .tl-n { font:800 30px/1 var(--display); letter-spacing:-.045em; margin:26px 0 4px; }
  .tl-w { font:500 11px/1.5 var(--mono); opacity:.8; }
  .tl-stats { margin-top:26px; display:grid; gap:14px; }
