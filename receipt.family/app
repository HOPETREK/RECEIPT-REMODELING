  $("sw-from").onchange = $("sw-to").onchange = () => { if ($("sw-from").value === $("sw-to").value) $("sw-to").value = SW.tokens.find((t) => t.symbol !== $("sw-from").value && t.tradable).symbol; swRefreshBalances(); swRequote(); };
  $("sw-amt").oninput = swRequote;
