  #m-receipts .rc .r a.m, #m-receipts .rc .r > span.m { display:none; }
  #m-receipts .rc .why { display:none; }
  #list .rc { grid-template-columns:auto minmax(0,1fr) 110px minmax(0,auto); padding:14px 16px; margin:0 -8px; border-top:0; border-radius:12px; gap:2px 14px; }
  #list .rc .tot { font:500 12px/1 var(--mono); color:var(--soft); font-variant-numeric:tabular-nums; }
  #list .rc .r { display:flex; align-items:center; justify-content:flex-end; gap:14px; max-width:none; white-space:nowrap; }
  #list .rc .r b { margin:0; min-width:110px; text-align:right; }
  #list .rc .r a.m, #list .rc .r > span.m, #list .rc .r > br, #list .rc .why span { display:none; }
  #list .rc .why { margin:0; max-width:none; }
  #list .rc .why .relook { margin:0; }
  #list .rc.sel { background:var(--bg); }
  #list .rc:hover { background:var(--bg); }
  .why { margin-top:8px; text-align:left; font:500 11px/1.6 var(--mono); color:var(--soft); max-width:220px; margin-left:auto; white-space:normal; }
  .why .relook { display:block; width:fit-content; margin-top:8px; padding:7px 12px; border:1px solid var(--hair2); border-radius:8px; cursor:pointer; background:transparent; color:var(--ink); font:600 10px/1 var(--mono); letter-spacing:.06em; text-transform:uppercase; }
  .why .relook:disabled { opacity:.5; }
  /* Taking a waiting receipt back: a quiet line under the actions, never a headline button. */
  .rs-remove { display:block; margin:14px auto 0; padding:4px 0; border:0; background:transparent; cursor:pointer; color:var(--faint); font:500 11px/1.4 var(--mono); text-decoration:underline; text-underline-offset:3px; }
  .rs-remove:hover { color:var(--ink); } .rs-remove:disabled { opacity:.5; }
  /* holdings: tiles on Home, rows on Move */
  .tiles { display:grid; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); gap:12px; margin-top:12px; }
  .tiles .hold { border:1px solid var(--hair); border-radius:14px; padding:16px 16px 14px; background:var(--bg); display:flex; flex-direction:column; gap:0; }
  .tiles .hold::before { display:none; }
  .tiles .hold .co { display:flex; flex-direction:column-reverse; gap:12px; font:700 15px/1.2 var(--display); letter-spacing:-.02em; }
  .tiles .hold .co span { display:flex; align-items:center; gap:8px; font:600 11px/1 var(--mono); letter-spacing:.08em; color:var(--soft); }
  .tiles .hold .co span::before { content:""; width:24px; height:24px; border-radius:7px; background:var(--c,var(--faint)); flex:none; }
  .tiles .hold .amt b { display:block; font:800 22px/1 var(--display); letter-spacing:-.04em; margin-top:8px; font-variant-numeric:tabular-nums; }
  .tiles .hold .amt .m { display:block; font:500 10.5px/1.4 var(--mono); color:var(--faint); margin-top:8px; }
  .tiles .hold.pending { opacity:.72; cursor:pointer; }
  .tiles .hold.pending .amt .m { color:var(--green); }
  .tiles .empty { grid-column:1/-1; }
  .list .hold { display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:4px 12px; align-items:center; padding:12px 0; border-top:1px solid var(--hair); font:500 12px/1.4 var(--mono); }
  .list .hold::before { content:""; width:28px; height:28px; border-radius:8px; background:var(--c,var(--faint)); }
  .list .hold .co { font:700 13.5px/1.2 var(--display); min-width:0; }
  .list .hold .co span { display:block; font:500 10.5px/1.4 var(--mono); color:var(--soft); margin-top:2px; letter-spacing:0; }
  .list .hold .amt { text-align:right; white-space:nowrap; }
  .list .hold .amt b { display:block; font:600 13px/1 var(--mono); font-variant-numeric:tabular-nums; }
  .list .hold .amt .m { display:block; font-size:10px; margin-top:4px; }
  .list .hold.pending { opacity:.72; }
  #bal-list .hold { grid-template-columns:auto minmax(0,1fr) auto auto; }
  .bal-acts { display:flex; gap:6px; }

  /* ---- receipts ---- */
  .rcp-grid { display:grid; grid-template-columns:minmax(0,1fr) 380px; gap:20px; align-items:start; }
  .rcp-grid > * { min-width:0; }
  .filters { display:flex; gap:6px; background:var(--paper); border:1px solid var(--hair); border-radius:10px; padding:4px; flex-wrap:wrap; }
  .filters button { padding:8px 12px; border:0; border-radius:7px; background:transparent; color:var(--soft); font:600 10.5px/1 var(--mono); letter-spacing:.08em; text-transform:uppercase; cursor:pointer; white-space:nowrap; }
  .filters button.on { background:var(--ink); color:var(--bg); }
  /* Under Transactions' filter bar the date labels bring their own 18px; a
     lone card (nothing yet, signed out) brought none and sat flush on it. */
  #tx-body > .card { margin-top:18px; }
  #list[data-filter="ok"] .rc:not(:has(.pill.ok)), #list[data-filter="wait"] .rc:not(:has(.pill.wait)), #list[data-filter="no"] .rc:not(:has(.pill.no)) { display:none; }
  .list-card { padding:8px 8px 8px 16px; }
  .now { font:500 12px/1.6 var(--mono); color:var(--ink); padding:12px 14px; border-radius:10px; background:var(--green3); margin:8px 8px 4px 0; }
  .now.idle { background:var(--bg); color:var(--soft); }
  .dot { display:inline-block; width:8px; height:8px; border-radius:50%; background:var(--green); margin-right:8px; vertical-align:1px; animation:pulse 1.8s infinite; }
  .now.idle .dot { animation:none; background:var(--faint); box-shadow:none; }
  .rs-dock { position:sticky; top:20px; }
  .stat3 { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--hair); border:1px solid var(--hair); border-radius:14px; overflow:hidden; margin-bottom:12px; }
  .stat3 > div { background:var(--paper); padding:14px 12px; }
  .stat3 .k { font-size:9px; margin-bottom:8px; }
  .stat3 b { display:block; font:800 18px/1 var(--display); letter-spacing:-.04em; font-variant-numeric:tabular-nums; }
  .rc-day { display:none; font:600 9.5px/1 var(--mono); letter-spacing:.2em; text-transform:uppercase; color:var(--faint); margin:20px 0 4px; }
  .rs-empty { padding:60px 24px; text-align:center; font:500 12px/1.6 var(--mono); color:var(--faint); }
  .rs-empty b { display:block; font:800 22px/1.1 var(--display); letter-spacing:-.03em; color:var(--ink); margin-bottom:10px; }
  .rs-shot { width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:12px; background:var(--paper2); margin:16px 0 4px; display:block; }
  .rs-title { font:800 26px/1 var(--display); letter-spacing:-.04em; margin:14px 0 4px; }
  .rs-head { display:flex; justify-content:space-between; align-items:center; gap:10px; }
  .rs-rows { width:100%; font:500 12.5px/1.5 var(--mono); margin-top:14px; }
  .rs-rows div { display:flex; justify-content:space-between; gap:14px; padding:9px 0; border-top:1px solid var(--hair); }
  .rs-rows div:first-child { border-top:0; }
  .rs-rows .kk { color:var(--soft); }
  .rs-rows .tot { border-top:2px dashed var(--hair2); align-items:baseline; padding-top:14px; margin-top:4px; }
  .rs-rows .tot .kk { font:600 10px/1 var(--mono); letter-spacing:.2em; text-transform:uppercase; }
  .rs-rows .tot b { font:800 28px/1 var(--display); letter-spacing:-.04em; color:var(--green); }
  .rs-items { margin-top:14px; font:500 11.5px/1.7 var(--mono); color:var(--soft); }
  .rs-items b { color:var(--ink); font-weight:600; }
  .rs-acts { display:flex; gap:8px; margin-top:14px; }
  .rs-acts .btn { flex:1; min-height:40px; }
  .rsheet { position:fixed; inset:0; z-index:70; background:rgba(11,11,12,.55); display:flex; align-items:flex-end; justify-content:center; }
  .rsheet-in { background:var(--paper); width:min(520px,100%); max-height:88vh; overflow:auto; padding:12px 22px calc(26px + env(safe-area-inset-bottom)); position:relative; border-radius:28px 28px 0 0; }
  .rsheet-in::before { content:""; display:block; width:40px; height:4px; border-radius:2px; background:var(--hair2); margin:0 auto 18px; }
  @media (min-width:900px) { .rsheet { align-items:center; } .rsheet-in { max-height:84vh; border-radius:18px; padding-top:22px; } .rsheet-in::before { display:none; } }
  .rs-x { position:absolute; right:12px; top:10px; border:0; background:transparent; font-size:26px; line-height:1; cursor:pointer; color:var(--soft); padding:4px 8px; }

  /* ---- scan ---- */
  .scan-one { display:grid; grid-template-columns:minmax(0,460px); gap:20px; justify-content:start; }
  .scan-one > * { min-width:0; }
  .qr-card { text-align:center; padding:28px; }
  .qr { display:inline-grid; place-items:center; padding:18px; background:var(--qr-bg); border-radius:14px; border:1px solid var(--hair); }
  .qr img, .qr canvas { display:block; width:200px; height:200px; }
  .qr:empty { display:none; }
  .qr-dead { padding:28px 20px; border-radius:14px; background:var(--bg); border:1px dashed var(--hair2); font:500 12px/1.6 var(--mono); color:var(--soft); }
  .qr-dead b { display:block; font:700 17px/1.3 var(--display); letter-spacing:-.02em; color:var(--ink); margin-bottom:6px; }
  #qrwrap.dead .qr-t, #qrwrap.dead .meta, #qrwrap.dead .linkrow, #qrwrap.dead #renew { display:none; }
  .qr-t { font:700 17px/1.3 var(--display); letter-spacing:-.02em; margin:20px 0 6px; }
  .qr-card .meta { font:500 11.5px/1.6 var(--mono); color:var(--soft); }
  .qr-card .meta b { color:var(--ink); font-weight:600; font-variant-numeric:tabular-nums; }
  .linkrow { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px; margin-top:18px; }
  .link { display:block; min-height:42px; padding:0 14px; border-radius:10px; background:var(--bg); border:1px solid var(--hair); font:500 11px/42px var(--mono); color:var(--soft); overflow:hidden; white-space:nowrap; text-overflow:ellipsis; text-align:left; }
  .linkrow .btn { width:auto; min-height:42px; padding:0 14px; }
  .qr-card .lnk { margin-top:12px; }
  #phonewrap .btn.lg { margin-top:4px; }
  .how { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  .how b { display:block; font:800 28px/1 var(--display); letter-spacing:-.04em; color:var(--green); }
  .how strong { display:block; font:700 14px/1.3 var(--display); margin:10px 0 4px; }
  .how span { display:block; font:500 11.5px/1.6 var(--mono); color:var(--soft); }
  .brands { display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:10px; }
  .brands .coin { display:flex; align-items:center; gap:10px; padding:12px 14px; border-radius:12px; border:1px solid var(--hair); background:var(--bg); min-width:0; }
  .brands .coin i { display:grid; place-items:center; width:28px; height:28px; border-radius:8px; font-style:normal; background:var(--c,var(--faint)); color:#fff; font:700 8px/1 var(--mono); flex:none; }
  .brands .coin em { font-style:normal; font:700 13px/1.2 var(--display); color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .brands .coin[hidden] { display:none; }
  .brands.dim span { padding:9px 12px; border-radius:10px; border:1px solid var(--hair); font:500 11px/1 var(--mono); color:var(--faint); }
  .brands.dim { display:flex; flex-wrap:wrap; gap:8px; }
