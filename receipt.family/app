      const j = await r.json().catch(() => ({}));
      if (!r.ok) {
        const why = { invalid_email: "That email does not look right.", email_required: "Add an email so we can answer you.", too_many_open: "You already have several open requests. We will get to them.", session_expired: "Your session expired. Sign in again and retry.", message_too_short: "Say a little more so we can help." }[j.error] || j.error || "Could not send. Try again.";
        st.className = "status bad"; st.textContent = why; btn.disabled = false; return;
      }
      st.className = "status ok"; st.textContent = wallet ? `Sent · request #${j.id}. The answer will appear here.` : `Sent · request #${j.id}. We will reply by email.`;
      $("sup-msg").value = ""; btn.disabled = false; loadHistory();
    } catch { st.className = "status bad"; st.textContent = "Could not send. Check your connection and try again."; btn.disabled = false; }
  };
})();
</script>
</body>
</html>