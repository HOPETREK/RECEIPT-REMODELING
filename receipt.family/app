          <div class="tk-row"><span>Tax</span><b>$48.04</b></div>
          <div class="tk-row"><span>Total</span><b>$597.04</b></div>
          <div class="tk-total"><span>You get</span><b>$17.91 in AAPL</b></div>
          <div class="tk-note"><span id="ru-base">3</span>% of the receipt, in Apple stock · <span id="ru-first">up to your tier's day</span></div>
        </div>
      </div>
    </div>
    <div hidden><b id="ru-ex-p"></b><b id="ru-ex-t"></b></div>
    <div id="avail">
      <div class="k">Paying out now</div>
      <div class="brands" id="live-brands"></div>
      <div class="k" style="margin-top:14px">Coming soon</div>
      <div class="brands dim" id="coming-brands"></div>
      <div class="rules">
        <div><b id="ru-pct">3%</b><span>of every receipt, in that brand's stock</span></div>
