// ---- Which wallets are actually here ----
// EIP-6963: every modern extension announces itself, so several can coexist
// and each is named. window.ethereum is one wallet pretending to be the only
// one — whichever extension won the race to claim it — which is why picking by
// isMetaMask guesses wrong the moment somebody runs two.
const EIP6963 = [];
window.addEventListener("eip6963:announceProvider", (e) => {
  const d = e.detail;
  if (d && d.provider && !EIP6963.some((x) => x.info.uuid === d.info.uuid)) EIP6963.push(d);
});
try { window.dispatchEvent(new Event("eip6963:requestProvider")); } catch {}

/** Every distinct injected wallet, named. Falls back to the legacy globals. */
function injectedWallets() {
  if (EIP6963.length) return EIP6963.map((d) => ({ name: d.info.name, provider: d.provider }));
  const w = window.ethereum;
  if (!w) return [];
  const all = Array.isArray(w.providers) && w.providers.length ? w.providers : [w];
  return all.map((p) => ({
    name: p.isMetaMask && !p.isPhantom ? "MetaMask" : p.isPhantom ? "Phantom" : p.isRabby ? "Rabby"
      : p.isCoinbaseWallet ? "Coinbase Wallet" : p.isBraveWallet ? "Brave" : "Browser wallet",
    provider: p,
  }));
}

/**
 * A phone browser has no extension: the wallet is an app, and the page has to
 * be opened inside that app's own browser to see a provider at all. These are
 * the two links that do it, and they are the whole answer for mobile until
 * WalletConnect exists here.
 */
function walletDeepLinks() {
  // MetaMask wants host+path with no scheme and no leading slash; a stray one
  // makes the link resolve to nothing inside the app.
  const host = (location.host + location.pathname + location.search).replace(/^\/+/, "").replace(/\/{2,}/g, "/");
  return [
    { name: "MetaMask", url: `https://metamask.app.link/dapp/${host}` },
    { name: "Phantom", url: `https://phantom.app/ul/browse/${encodeURIComponent(location.href)}?ref=${encodeURIComponent(location.origin)}` },
  ];
}

/** Ask which wallet, when more than one is here. Resolves to a provider or null. */
function pickWallet(wallets) {
  if (wallets.length === 1) return Promise.resolve(wallets[0].provider);
  return new Promise((resolve) => {
    const box = document.createElement("div");
    box.className = "wpick";
    box.innerHTML = `<div class="wpick-c"><div class="wpick-h">Which wallet holds your $RECEIPT?</div>`
      + wallets.map((w, i) => `<button type="button" data-i="${i}">${esc(w.name)}</button>`).join("")
      + `<button type="button" class="wpick-x" data-i="-1">Cancel</button></div>`;
    box.onclick = (e) => {
      const b = e.target.closest("button");
      if (!b && e.target !== box) return;
      const i = b ? Number(b.dataset.i) : -1;
      box.remove();
      resolve(i >= 0 ? wallets[i].provider : null);
    };
    document.body.appendChild(box);
  });
}

// ---- Linking a wallet that holds the tokens ----
// The tier reads the signed-in wallet's balance, but a lot of people hold
// $RECEIPT somewhere else — an email sign-in with the tokens in MetaMask earns
// Paper while holding Gold. Linking proves that other address is theirs, with
// a signature from the address itself, and its balance counts from then on.
$("tb-link").onclick = async () => {
  const btn = $("tb-link");
  const wallets = injectedWallets();
  if (!wallets.length) {
    // On a phone this is the normal case, not an error: the wallet is an app,
    // and the page has to be opened inside it. Say so, and offer the way in.
    if (isPhone()) {
      const links = walletDeepLinks()
        .map((l) => `<a href="${l.url}" style="text-decoration:underline">${l.name}</a>`).join(" · ");
      $("tb-linkhelp").innerHTML = `Open this page inside your wallet app to link it: ${links}`;
      $("tb-linkhelp").hidden = false;
    } else {
      say("s1", "No browser wallet found. Install MetaMask, Rabby or Phantom to link one.", "bad");
    }
    return;
  }
  btn.disabled = true;
  const was = btn.textContent;
  try {
    btn.textContent = "Opening…";
    // Which wallet holds the tokens is the person's to say — it is often not
    // the one they signed in with, and guessing picks whichever extension
    // happened to claim the global.
    const provider = await pickWallet(wallets);
    if (!provider) return;
    const [holding] = await provider.request({ method: "eth_requestAccounts" });
    if (!holding) throw new Error("No account");
    if (holding.toLowerCase() === String(wallet).toLowerCase()) {
      say("s1", "That is the wallet you are signed in with — its balance already counts.");
      return;
    }
    btn.textContent = "Sign…";
    const message = `RECEIPT holding wallet\nAccount: ${wallet}\nHolding: ${holding}\nIssued: ${new Date().toISOString()}`;
    const signature = await signMessage(provider, message, holding);
    btn.textContent = "Linking…";
    const r = await fetch(`${API}/api/receipts/holding-wallet`, {
      method: "POST", headers: { "content-type": "application/json" },
      body: JSON.stringify({ wallet, address: holding, message, signature }),
    });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) {
      say("s1", j.error === "address_already_linked" ? "That wallet is already linked to another account."
