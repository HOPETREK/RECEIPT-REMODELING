      const dayLabel = (d) => { const a = new Date(d), b = new Date(); a.setHours(0,0,0,0); b.setHours(0,0,0,0); const diff = Math.round((b - a) / 86400000); return diff === 0 ? "Today" : diff === 1 ? "Yesterday" : new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric" }); };
      const dayHead = i === 0 || dayLabel(rows[i - 1].created_at) !== dayLabel(x.created_at) ? `<div class="rc-day">${dayLabel(x.created_at)}</div>` : "";
