          <div class="tlx-m">${esc(ago(x.delivered_at || x.created_at))} · #${esc(String(x.id))}${x.chain === "solana" ? " · Solana" : ""}${x.tx_hash
            ? ` · <a href="${explorerFor(x)}/tx/${esc(x.tx_hash)}" target="_blank" rel="noopener">on chain ↗</a>`
            : settled ? "" : " · in progress"}</div>
        </div>
        <div class="tlx-a">${amt != null ? `<b>+${money(amt)}</b>` : "<b>—</b>"}
          ${x.est_shares ? `<span class="m">${Number(x.est_shares).toFixed(4)} ${esc(x.ticker || "")}</span>` : ""}</div>
      </div>`;
    }).join("")}`).join("");
}
