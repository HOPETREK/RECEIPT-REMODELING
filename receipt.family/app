  };

  // Taking a lock back goes through the same function the Lock screen uses, so
  // there is one path that returns tokens rather than two that could drift.
  for (const b of body.querySelectorAll("[data-unlock]")) b.onclick = () => unlockNow(Number(b.dataset.unlock), b);
