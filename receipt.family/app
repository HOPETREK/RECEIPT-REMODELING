/**
 * Receipts this device photographed before anyone was signed in.
 *
 * The phone scanner no longer needs a wallet: it parks the photo and the wallet
 * catches up here. Claiming is what actually reads and judges each one, against
 * this wallet's caps and tier, so the results land in history exactly as if
 * they had been scanned signed in.
 *
 * Every failure here is silent on purpose. The receipts stay parked and the
 * next sign-in tries again; an error toast about a background claim, on the
 * screen someone reaches by signing in, would be noise about something they
 * did not ask for yet.
 */
async function claimParked() {
  let deviceId = null;
  try { deviceId = localStorage.getItem("receipt.device"); } catch {}
  if (!deviceId || !token) return;
  try {
    const r = await fetch(`${API}/api/receipts/park/claim`, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token, deviceId }),
    });
    if (!r.ok) return;
    const j = await r.json();
    const claimed = (j.claimed || []).filter((c) => c.status && c.status !== "unclaimable");
    if (!claimed.length) return;
    // The parked list is this device's memory of what it is owed; anything the
    // server has now answered for is spent, whatever the answer was.
    try { localStorage.removeItem("receipt.parked"); } catch {}
    loadRewards();
    const n = claimed.length;
    const earned = claimed.filter((c) => c.status === "approved");
    const note = earned.length
      ? `Claimed ${n} receipt${n === 1 ? "" : "s"} you scanned before signing in.`
      : `Claimed ${n} receipt${n === 1 ? "" : "s"} — ${n === 1 ? "it's" : "they're"} being checked.`;
    const el = document.getElementById("s1");
    if (el) say("s1", note, "ok");
  } catch {}
}

/** A scanner link on this device: the live QR link, else this session's own. */
function scanUrl() {
  try {
    const saved = JSON.parse(localStorage.getItem("receipt.session") || "null");
    if (!saved) return null;
    if (saved.url) {
      const until = new Date(saved.scanExpiresAt || saved.expiresAt);
      if (until > new Date()) return saved.url;
    }
    // The QR link has expired but the sign-in has not: same wallet, same
    // device, and the token the scanner checks is valid either way.
    if (saved.token && new Date(saved.expiresAt) > new Date()) {
      return `/scan#t=${encodeURIComponent(saved.token)}`;
    }
    return null;
  } catch { return null; }
}
