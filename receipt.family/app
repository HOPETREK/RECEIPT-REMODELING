      <div class="hold pending ${brandCls(x.ticker)}" ${brandStyle(x.ticker)} data-rc="${esc(String(x.id))}" role="button" tabindex="0">
        <div class="co">${esc(x.company || x.merchant || "Receipt")}<span>${x.ticker ? esc(x.ticker) : "being read"}${x.chain === "solana" ? " · Solana" : ""}</span></div>
