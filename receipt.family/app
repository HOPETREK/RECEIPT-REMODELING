        </div>
        <div style="text-align:right">
          <b style="display:block;font:700 14px/1 var(--mono);white-space:nowrap;color:${m.cls === "down" ? "var(--soft)" : "var(--green)"}">${m.sign}${esc(sh(a.shares))}</b>
          ${a.usd != null ? `<span class="status" style="display:block;margin-top:3px">${money(a.usd)}</span>` : ""}
        </div>
      </div>`;
    }).join("")}</div>`).join("");
}

// ===== SPENDING =====
// The person's own receipts, added up. Everything here is read from rows they
// scanned themselves, so the copy says "you" and the page never compares them
// to anybody else.
const SPEND = { data: null, loaded: false };

/** A month key ("2026-09") as a short label. */
const spMonth = (key) => {
  const [y, m] = String(key).split("-").map(Number);
  if (!y || !m) return String(key);
  return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString("en-US", { month: "short", year: "2-digit", timeZone: "UTC" });
};
const spDate = (d) => d ? new Date(d).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "";
/** Whole dollars, for the headline figures: cents on a yearly total is noise. */
const spRound = (n) => "$" + Math.round(Number(n) || 0).toLocaleString("en-US");

async function loadSpending() {
  const body = $("sp-body");
  if (!body) return;
  if (DEMO) return drawSpending(demoSpending());
  if (!wallet) {
    body.innerHTML = `<div class="card"><h3 class="ct">Sign in to see your spending.</h3><p class="status" style="margin-top:0">Every receipt you scan is added up here — where your money goes, and what it used to cost.</p></div>`;
    return;
  }
  // Already drawn once: refresh quietly rather than blanking what is on screen.
  if (!SPEND.loaded) body.innerHTML = `<div class="empty">Loading…</div>`;
  try {
    const r = await fetch(`${API}/api/receipts/spending?token=${encodeURIComponent(token || "")}`, { cache: "no-store" });
    if (!r.ok) throw new Error("http " + r.status);
    SPEND.data = await r.json();
    SPEND.loaded = true;
    drawSpending(SPEND.data);
  } catch {
    if (!SPEND.loaded) body.innerHTML = `<div class="empty">Couldn't load your spending. Try again in a moment.</div>`;
  }
}

/**
 * ?reel=1 — the numbers arrive instead of being there already.
 *
 * Only for the showreel (dev-spending.html), which records this screen inside
 * a phone: a page of final figures reads as a still photograph on video, and
 * the one thing a spending screen has to say is that it adds up. The app
 * itself never sets this, so nothing a real person sees is affected.
 */
const REEL = new URLSearchParams(location.search).get("reel") === "1";

/**
 * Count a number up to its value, easing out. Separate from countUp() above,
 * which writes to a fixed element id; this one animates whatever node it is
 * handed, after the card it lives in has been built.
 */
function spCount(el, to, fmt, ms = 1100, delay = 0) {
  if (!el) return;
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) { el.textContent = fmt(to); return; }
  el.textContent = fmt(0);
  const t0 = performance.now() + delay;
  requestAnimationFrame(function step(now) {
    const k = Math.max(0, Math.min(1, (now - t0) / ms));
    el.textContent = fmt(to * (1 - Math.pow(1 - k, 3)));
    if (k < 1) requestAnimationFrame(step);
  });
}

/**
 * Play the screen in: totals count, bars grow, rows arrive in order.
 *
 * Every bar is written with its final width in the markup and re-read here,
 * so the animation is a replay of the truth rather than a second source of it
 * — a bar can never finish at a width the data did not ask for.
 */
function reelSpending(d) {
  const body = $("sp-body");
  const t = (d && d.totals) || {};
  const big = body.querySelector(".big");
  if (big && t.spendingUsd != null) spCount(big, t.spendingUsd, (v) => "$" + Math.round(v).toLocaleString("en-US"), 1200, 160);
  // Month bars rise from the floor, left to right.
  body.querySelectorAll(".sp-bar i").forEach((el, i) => {
    const h = el.style.height; el.style.height = "0%";
    el.style.transition = "height .75s cubic-bezier(.2,.8,.25,1)";
    setTimeout(() => { el.style.height = h; }, 620 + i * 85);
  });
  // Category bars fill from the left.
  body.querySelectorAll(".sp-track i").forEach((el, i) => {
    const w = el.style.width; el.style.width = "0%";
    el.style.transition = "width .8s cubic-bezier(.2,.8,.25,1)";
    setTimeout(() => { el.style.width = w; }, 1200 + i * 90);
  });
  // Rows and cards arrive rather than being there already.
  body.querySelectorAll(".card").forEach((el, i) => {
    el.style.opacity = "0"; el.style.transform = "translateY(14px)";
    el.style.transition = "opacity .6s ease, transform .6s cubic-bezier(.2,.8,.25,1)";
    setTimeout(() => { el.style.opacity = "1"; el.style.transform = "none"; }, i * 210);
  });
  body.querySelectorAll(".sp-row").forEach((el, i) => {
    el.style.opacity = "0";
    el.style.transition = "opacity .5s ease";
    setTimeout(() => { el.style.opacity = "1"; }, 900 + i * 70);
  });
}

function drawSpending(d) {
  const body = $("sp-body");
  if (!body || !d) return;
  const t = d.totals || {};
  if (!t.receipts) {
    body.innerHTML = `<div class="card"><h3 class="ct">Nothing to add up yet.</h3><p class="status" style="margin-top:0">Scan a receipt and this fills in — what you spend, where it goes, and what things used to cost.</p><button class="btn" type="button" data-go="scan" style="width:auto;margin-top:16px">Scan a receipt</button></div>`;
    return;
  }
  body.innerHTML = [
    spTotals(t),
    spMonths(d.months || []),
    spCategories(d.categories || []),
    spPlaces(d.places || []),
    spWhen(d.days || [], d.hours || [], d.hourCoverage || {}),
    // The price watch draws nothing at all when there is no matched repeat.
    // An empty panel would read as a broken feature; an absent one reads as
    // a feature that has not got anything to say yet, which is the truth.
    spPriceWatch(d.priceWatch || [], d.itemCoverage || {}),
  ].join("");
  if (REEL) reelSpending(d);
}

/** What went out, what came back. */
function spTotals(t) {
  const since = t.firstAt ? `Since ${spDate(t.firstAt)}` : "";
  return `<div class="card" style="container-type:inline-size">
    <div class="k">You've spent</div>
    <div class="big">${spRound(t.spendingUsd)}</div>
    <p class="status" style="margin-top:0">${esc(since)}${since ? " · " : ""}${t.receipts} receipt${t.receipts === 1 ? "" : "s"}${t.averageUsd != null ? ` · ${money(t.averageUsd)} a visit` : ""}</p>
    ${t.earnedUsd > 0 ? `<p class="status" style="margin-top:8px">You got <b>${money(t.earnedUsd)}</b> of that back.</p>` : ""}
  </div>`;
}

/**
 * Spending by month, as bars.
 *
 * Only the months that have receipts in them: a zero-filled gap would claim
 * somebody spent nothing in a month they had simply not joined yet.
 */
function spMonths(months) {
  if (months.length < 2) return "";
  // Bars are measured from zero, not from the smallest month. Scaling the
  // floor to the minimum exaggerates every difference: a $388 month beside a
  // $703 one would draw at nearly the same height and say something false.
  const peak = Math.max(...months.map((m) => m.spendingUsd), 1);
  return `<div class="card" style="margin-top:14px">
    <div class="k">Month by month</div>
    <div class="sp-bars">
      ${months.map((m) => `<div class="sp-bar" title="${esc(spMonth(m.month))}: ${esc(spRound(m.spendingUsd))} over ${m.receipts} receipt${m.receipts === 1 ? "" : "s"}">
        <span class="sp-col"><i style="height:${Math.max(3, Math.round((m.spendingUsd / peak) * 100))}%"></i></span>
        <span>${esc(spMonth(m.month))}</span>
        <b>${esc(spRound(m.spendingUsd))}</b>
      </div>`).join("")}
    </div>
  </div>`;
}

/** Where the money goes. Uncategorised receipts are left out, and it says so. */
function spCategories(cats) {
  if (!cats.length) return "";
  const shown = cats.slice(0, 8);
  return `<div class="card" style="margin-top:14px">
    <div class="k">Where it goes</div>
    <div class="sp-rows">
      ${shown.map((c) => `<div class="sp-row">
        <span class="sp-name" style="display:flex;align-items:center;gap:10px"><i class="sp-ico" aria-hidden="true">${CAT_ICON[c.id] || "•"}</i>${esc(c.name)}</span>
        <span class="sp-track"><i style="width:${Math.max(2, Math.round(c.share * 100))}%"></i></span>
        <b>${esc(spRound(c.spendingUsd))}</b>
        <span class="sp-pct">${Math.round(c.share * 100)}%</span>
      </div>`).join("")}
    </div>
  </div>`;
}

/**
 * A shop's own colour, for the mark beside its name.
 *
 * Folded on the same lowercased, trimmed name the server groups by, and
 * matched on a contained word so "Costco Wholesale" and "Costco" are one
 * brand. Anything not listed falls back to ink — deliberately plain rather
 * than a random colour, which would imply a brand identity we do not know.
 */
/** A glyph per category, matching the Plus catalogue's own icons. */
const CAT_ICON = {
  meal: "\u{1F354}", coffee: "\u2615", grocery: "\u{1F6D2}", fuel: "\u26FD",
  pharmacy: "\u{1F48A}", shop: "\u{1F6CD}\uFE0F", transit: "\u{1F695}", phone: "\u{1F4F1}",
  gym: "\u{1F3CB}\uFE0F", beauty: "\u{1F488}", pet: "\u{1F43E}", kids: "\u{1F9F8}",
  home: "\u{1F6CB}\uFE0F", travel: "\u2708\uFE0F", hotel: "\u{1F3E8}", entertainment: "\u{1F3AC}",
};

/**
 * Merchants the app already has a ticker for. Their colour comes from BRAND
 * above — the app's existing table, and the one the design handoff specifies
 * (COST #C8102E, AAPL the theme-aware --aapl). Hand-picking values here is
 * how one screen quietly becomes a different red from the rest of the app.
 */
const MERCHANT_TICKER = [
  ["costco", "COST"], ["starbucks", "SBUX"], ["mcdonald", "MCD"],
  ["walmart", "WMT"], ["amazon", "AMZN"], ["apple", "AAPL"],
  ["gamestop", "GME"], ["amc", "AMC"], ["exxon", "XOM"],
  ["nvidia", "NVDA"], ["coca", "KO"], ["coke", "KO"],
];

/** Shops the app has no ticker for, so no canonical colour to defer to. */
const BRAND_COLORS = [
  ["shell", "#DD1D21"],
  ["chipotle", "#A81612"],
  ["target", "#CC0000"],
  ["whole foods", "#00674B"], ["trader joe", "#D23B33"], ["kroger", "#0060A9"],
  ["cvs", "#CC0000"], ["walgreens", "#E01A2B"], ["dunkin", "#FF671F"],
  ["subway", "#008C15"], ["chevron", "#0B5DA6"], ["exxon", "#CE1126"],
  ["bp", "#009A44"], ["safeway", "#E31837"], ["publix", "#007A33"],
  ["home depot", "#F96302"], ["lowe", "#004990"], ["best buy", "#0046BE"],
  ["gamestop", "#ED1C24"], ["nike", "#111111"], ["uber", "#000000"],
  ["lyft", "#FF00BF"], ["delta", "#003268"], ["marriott", "#A70E13"],
  ["7-eleven", "#F37021"], ["wendy", "#E2203D"], ["burger king", "#D62300"],
  ["taco bell", "#702082"], ["panera", "#5C8727"], ["ikea", "#0058A3"],
];

/** The mark itself: the brand's colour, and the first letter of its name. */
function spMark(name) {
  const key = String(name || "").toLowerCase().trim();
  const tick = MERCHANT_TICKER.find(([k]) => key.includes(k));
  const listed = tick && BRAND[tick[1]] ? BRAND[tick[1]].c : null;
  const hit = listed || (BRAND_COLORS.find(([k]) => key.includes(k)) || [])[1];
  const letter = (key.replace(/[^a-z0-9]/g, "")[0] || "?").toUpperCase();
  const bg = hit || "var(--ink)";
  return `<i class="sp-logo" style="background:${esc(bg)}" aria-hidden="true"><span>${esc(letter)}</span></i>`;
}

/** The shops you actually go to. */
function spPlaces(places) {
  if (!places.length) return "";
  return `<div class="card" style="margin-top:14px">
    <div class="k">Your places</div>
    <div class="sp-rows">
      ${places.slice(0, 10).map((p) => `<div class="sp-row sp-place">
        <span class="sp-name">${spMark(p.merchant)}${esc(p.merchant)}</span>
        <span class="sp-vis">${p.visits} visit${p.visits === 1 ? "" : "s"} · ${money(p.averageUsd)} each</span>
        <b>${esc(spRound(p.spendingUsd))}</b>
      </div>`).join("")}
    </div>
  </div>`;
}

/**
 * When the money actually goes out — the day of the week, and the time of day.
 *
 * Two different questions with two different sources, which is why they are
 * drawn as two blocks rather than one. The week comes from the printed
 * purchase date and covers every receipt. The clock comes from `time_printed`
 * and covers only the receipts whose printed time could be read, so it says
 * so underneath and hides itself when there is nothing solid to show.
 */
function spWhen(days, hours, cov) {
  if (!days.length && !hours.length) return "";
  const peak = Math.max(...days.map((d) => d.spendingUsd), 1);
  const busiest = [...days].sort((a, b) => b.spendingUsd - a.spendingUsd)[0];
  const hoursOn = hours.filter((h) => h.receipts > 0);
  // Under five timed receipts is not a pattern, it is a handful of purchases.
  const showHours = hoursOn.length > 0 && (cov.withTime || 0) >= 5;
  const topHour = showHours ? [...hoursOn].sort((a, b) => b.spendingUsd - a.spendingUsd)[0] : null;
  return `<div class="card" style="margin-top:14px">
    <div class="k">When it goes out</div>
    ${busiest && busiest.spendingUsd > 0 ? `<p class="status" style="margin:0 0 14px"><b>${esc(busiest.name)}</b> is your most expensive day${topHour ? `, and most of it goes in the <b>${esc(topHour.name.toLowerCase())}</b>` : ""}.</p>` : ""}
    <div class="sp-week">
      ${days.map((d) => `<div class="sp-day" title="${esc(d.name)}: ${esc(spRound(d.spendingUsd))} over ${d.receipts} receipt${d.receipts === 1 ? "" : "s"}">
        <span class="sp-col"><i style="height:${Math.max(2, Math.round((d.spendingUsd / peak) * 100))}%"></i></span>
        <span>${esc(d.name.slice(0, 3))}</span>
      </div>`).join("")}
    </div>
    ${showHours ? `<div class="sp-rows" style="margin-top:18px">
      ${hoursOn.map((h) => `<div class="sp-row">
        <span class="sp-name">${esc(h.name)}<span class="sp-at">${esc(h.window)}</span></span>
        <span class="sp-track"><i style="width:${Math.max(2, Math.round(h.share * 100))}%"></i></span>
        <b>${esc(spRound(h.spendingUsd))}</b>
        <span class="sp-pct">${Math.round(h.share * 100)}%</span>
      </div>`).join("")}
    </div>
    <p class="status" style="margin-top:14px">Timed from the ${cov.withTime} of your ${cov.receipts} receipts that printed a clock time.</p>` : ""}
  </div>`;
}

/**
 * The same thing, bought twice at the same shop, at two different prices.
 *
 * Returns nothing at all unless there is a real matched repeat. Most people
 * have scanned one or two receipts and will never see this; the section
 * appears on its own once they have bought something twice.
 */
function spPriceWatch(watch, cov) {
  if (!watch.length) return "";
  return `<div class="card" style="margin-top:14px">
    <div class="k">What it used to cost</div>
    <p class="status" style="margin:0 0 14px">Things you've bought more than once at the same shop.</p>
    <div class="sp-rows">
      ${watch.map((w) => {
        const up = w.changeUsd > 0, flat = Math.abs(w.changeUsd) < 0.005;
        const cls = flat ? "flat" : up ? "up" : "down";
        const sign = flat ? "" : up ? "+" : "−";
        return `<div class="sp-row sp-watch">
          <span class="sp-name">${spMark(w.merchant)}<span>${esc(w.name)}<span class="sp-at">${esc(w.merchant)}</span></span></span>
          <span class="sp-then">${money(w.firstUsd)}<i>${esc(spDate(w.firstAt))}</i></span>
          <span class="sp-arrow">→</span>
          <span class="sp-now">${money(w.lastUsd)}<i>${esc(spDate(w.lastAt))}</i></span>
          <b class="sp-delta ${cls}">${flat ? "same" : `${sign}${money(Math.abs(w.changeUsd))}`}</b>
        </div>`;
      }).join("")}
    </div>
    ${cov && cov.receipts ? `<p class="status" style="margin-top:14px">Read from the ${cov.withItems} of your ${cov.receipts} receipts with a readable list of items.</p>` : ""}
  </div>`;
}

