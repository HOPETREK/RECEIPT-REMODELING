<script>
// Hold the first paint for the web fonts, never longer than 300ms. They are
// cached after the first visit but still landed a frame after the page, so
// every label in the rail changed face and moved a pixel on each load.
try {
  const de = document.documentElement, go = () => de.classList.remove("fonts-wait");
  de.classList.add("fonts-wait"); setTimeout(go, 300);
  Promise.all(["600 1em 'Bricolage Grotesque'", "800 1em 'Bricolage Grotesque'", "500 1em 'IBM Plex Mono'", "600 1em 'IBM Plex Mono'"].map((f) => document.fonts.load(f))).then(go, go);
} catch {}
// Appearance, before first paint: a stored choice wins, otherwise the system's.
try { const t = localStorage.getItem("receipt.theme"); if (t === "dark" || t === "light") document.documentElement.dataset.theme = t; } catch {}
// Inside the recording frame (dev-phone.html) the page leaves room for the phone's own status bar and home indicator.
if (new URLSearchParams(location.search).get("frame")) document.documentElement.classList.add("framed");
</script>
