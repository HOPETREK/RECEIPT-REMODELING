// ---- Notifications ---------------------------------------------------------
// A receipt held for review is decided by a person, minutes or hours later.
// The poll above covers an open tab and nothing else, so someone who scans and
// closes the app learns nothing until they come back and look. Push is the one
// channel a wallet alone can reach.
//
// The browser only grants permission on a gesture, and only asks once — a
// refused prompt is refused for good. So it is never asked on load: it is
// offered after a scan has actually gone to review, which is the moment the
// answer to "why would I allow this?" is on the screen.
const PUSH = (() => {
  const KEY = "receipt.push.asked";
  const b64 = (s) => {
    const pad = "=".repeat((4 - (s.length % 4)) % 4);
    const raw = atob((s + pad).replace(/-/g, "+").replace(/_/g, "/"));
    return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
  };
  const supported = () => "serviceWorker" in navigator && "PushManager" in window && "Notification" in window;

  async function subscribe() {
    if (!supported() || !wallet || !token) return false;
    let cfg;
    try { cfg = await (await fetch(`${API}/api/receipts/push/key`)).json(); } catch { return false; }
    if (!cfg.enabled || !cfg.publicKey) return false;
    const reg = await navigator.serviceWorker.ready;
    let sub = await reg.pushManager.getSubscription();
    if (!sub) {
      sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: b64(cfg.publicKey) });
    }
    const r = await fetch(`${API}/api/receipts/push/subscribe`, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token, subscription: sub.toJSON() }),
    });
    return r.ok;
  }

  // Ask, once, and only when there is something to be notified about.
  async function offer() {
    if (!supported() || !wallet || !token) return;
    if (Notification.permission === "denied") return;
    if (Notification.permission === "granted") { subscribe().catch(() => {}); return; }
    try { if (localStorage.getItem(KEY)) return; } catch {}
    try { localStorage.setItem(KEY, "1"); } catch {}
    const granted = await Notification.requestPermission().catch(() => "default");
    if (granted === "granted") subscribe().catch(() => {});
  }

  // A permission already granted on another visit still needs its subscription
  // stored against this wallet — the row is per device and per wallet.
  function resume() {
    if (supported() && wallet && token && Notification.permission === "granted") subscribe().catch(() => {});
  }
  return { offer, resume };
})();


