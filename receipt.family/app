  .sp-vis { color:var(--faint); font-size:11.5px; white-space:nowrap; }
  /* Brand marks. The app has no logo files and fetches none: a remote logo
     service would be a third-party request on a signed-in page, and it fails
     exactly where this is recorded (offline, in a frame). So a mark is the
     brand's own colour and its initial, drawn here. A shop we have no colour
     for gets the ink tile, which is the same shape and never looks broken. */
  .sp-logo { flex:0 0 26px; width:26px; height:26px; border-radius:7px; display:grid; place-items:center;
    font:700 11px/1 var(--display); letter-spacing:-.02em; color:#fff; background:var(--ink); overflow:hidden; }
