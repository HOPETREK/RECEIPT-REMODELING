  const opts = SW.tokens.map((t) => `<option value="${esc(t.symbol)}" ${t.tradable ? "" : "disabled"}>${esc(t.symbol)}${t.tradable ? "" : " · no liquidity"}</option>`).join("");
  $("sw-from").innerHTML = opts; $("sw-to").innerHTML = opts;
