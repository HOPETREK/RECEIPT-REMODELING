  /* ---- the buy sheet, the ask sheet, the wallet picker ---- */
  .modal { position:fixed; inset:0; z-index:80; display:flex; align-items:center; justify-content:center; padding:20px; background:rgba(20,19,17,.5); backdrop-filter:blur(3px); }
