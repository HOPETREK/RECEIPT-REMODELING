    const p = new ethers.JsonRpcProvider(CHAIN.rpcUrls[0], { chainId: 4663, name: "robinhood" }, { staticNetwork: true });
    for (const t of SW.tokens) {
      const raw = t.native ? await p.getBalance(wallet) : await new ethers.Contract(t.address, ERC20_ABI, p).balanceOf(wallet);
      swBal[t.symbol] = Number(ethers.formatUnits(raw, t.decimals));
