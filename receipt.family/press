    --green:#0E8A4F;
    --display:&#34;Bricolage Grotesque&#34;,&#34;Helvetica Neue&#34;,Arial,sans-serif;
    --mono:&#34;IBM Plex Mono&#34;,ui-monospace,Menlo,monospace;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--display);
    -webkit-font-smoothing:antialiased}
  .wrap{width:min(1080px,100% - 48px);margin-inline:auto}
  header{padding:64px 0 56px;border-bottom:1px solid var(--hair)}
  .head-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);
    gap:48px;align-items:start}
  /* aligns with the top of the headline, not the bottom of the column */
  .head-art{display:flex;justify-content:center;align-items:flex-start;padding-top:52px}
  .head-art img{width:min(200px,100%);height:auto;display:block}
  @media(max-width:820px){.head-grid{grid-template-columns:1fr;gap:28px}
    /* stacked: no top padding, and the glyph sits with the text */
    .head-art{justify-content:flex-start;padding-top:0}.head-art img{width:104px}}
  .brand{display:flex;align-items:center;gap:14px;text-decoration:none;color:inherit}
  .brand img{width:34px;height:34px;display:block}
  .brand b{font-size:23px;font-weight:800;letter-spacing:-.03em}
  .kicker{font:500 11px/1 var(--mono);letter-spacing:.22em;color:var(--faint);
    text-transform:uppercase;margin:42px 0 16px}
  h1{font-size:clamp(40px,6.4vw,68px);font-weight:800;letter-spacing:-.045em;line-height:.98;margin:0}
  .lede{font:400 16px/1.72 var(--mono);color:var(--soft);max-width:58ch;margin-top:24px}
  .status{display:inline-flex;align-items:center;gap:9px;margin-top:28px;
    font:500 11.5px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--soft)}
  .status .dot{width:6px;height:6px;border-radius:50%;background:var(--green);flex:none}
  .legal{font:400 13.5px/1.85 var(--mono);color:var(--soft);max-width:74ch}
  .legal p{margin:0 0 14px}
  .legal p:last-child{margin:0}
  .legal b{color:var(--ink);font-weight:600}
  section{padding:64px 0;border-bottom:1px solid var(--hair)}
  h2{font-size:11px;font-family:var(--mono);font-weight:600;letter-spacing:.22em;
    text-transform:uppercase;color:var(--faint);margin:0 0 30px}
  .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  @media(max-width:900px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:560px){.grid{grid-template-columns:1fr}}
  .card{border:1px solid var(--hair);background:var(--bg2);padding:30px 26px 22px;display:flex;
    flex-direction:column;align-items:center;justify-content:space-between;min-height:196px;gap:22px;
    transition:border-color .18s ease, background .18s ease}
  .card:hover{border-color:rgba(29,29,31,.24)}
  .card .art{flex:1;display:flex;align-items:center;justify-content:center;width:100%}
  .card.dark{background:var(--ink);border-color:var(--ink)}
  .card.dark:hover{border-color:#3a3a3d}
  .card img{max-width:168px;max-height:96px;width:auto;height:auto;display:block}

  /* nav, matching the landing page */
  nav{position:sticky;top:0;z-index:60}
  nav::before{content:&#34;&#34;;position:absolute;inset:0;z-index:-1;background:rgba(255,255,255,.72);
    backdrop-filter:blur(18px) saturate(1.2);border-bottom:1px solid var(--hair)}
  .nav-in{display:flex;align-items:center;justify-content:space-between;padding:18px 0;gap:20px}
  .brand{display:flex;align-items:center;gap:12px;font-weight:800;letter-spacing:-.05em;
    font-size:21px;text-decoration:none;color:inherit;font-family:var(--display)}
  .brand img{width:22px;height:22px;display:block;flex:none}
  .nav-meta{font:500 11px/1 var(--mono);letter-spacing:.22em;text-transform:uppercase;color:var(--faint)}
  .nav-links{display:flex;gap:30px;align-items:center}
  .nav-links a{color:var(--soft);text-decoration:none;font:500 12px/1 var(--mono);
    letter-spacing:.08em;text-transform:uppercase;transition:color .2s}
  .nav-links a:hover{color:var(--ink)}
  .nav-links .btn,.nav-links .btn:hover{color:#fff}
  .xlink{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;
    color:var(--soft);transition:color .2s,transform .2s}
  .xlink:hover{color:var(--ink);transform:translateY(-1px)}
  .xi{width:17px;height:17px;display:block}
  .btn{display:inline-flex;align-items:center;gap:10px;padding:11px 18px;border:0;background:var(--ink);
    color:#fff;text-decoration:none;font:600 11.5px/1 var(--mono);letter-spacing:.1em;
    text-transform:uppercase;transition:transform .2s,box-shadow .2s}
  .btn:hover{transform:translateY(-1px);box-shadow:0 14px 30px -14px rgba(14,13,12,.6)}
  @media(max-width:900px){.nav-links .hide-sm,.nav-meta{display:none}}


  .socials{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  @media(max-width:760px){.socials{grid-template-columns:1fr}}
  .banner{border:1px solid var(--hair);background:var(--bg2);padding:20px;display:flex;flex-direction:column;gap:14px}
  .banner .shot{background:#fff;box-shadow:inset 0 0 0 1px var(--hair);display:flex;align-items:center;justify-content:center;padding:10px}
  .banner img{max-width:100%;height:auto;display:block}
  .banner .meta{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
  .banner .cname{margin:0}
  .banner .dim{font:500 10.5px/1 var(--mono);letter-spacing:.12em;color:var(--faint)}
  .wide{grid-column:1 / -1}
  .links{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
  .cname{font:600 11px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--soft);margin-bottom:2px}
  .card.dark .cname{color:#B9B2A8}
  .dl{display:inline-flex;align-items:center;gap:7px;font:600 10.5px/1 var(--mono);letter-spacing:.14em;
    text-transform:uppercase;color:var(--ink);text-decoration:none;padding:9px 13px;background:#fff;
    box-shadow:inset 0 0 0 1px var(--hair2);transition:background .18s,color .18s,box-shadow .18s}
  .dl::after{content:&#34;↓&#34;;font-size:12px;opacity:.5;transition:transform .18s,opacity .18s}
  .dl:hover{background:var(--ink);color:#fff;box-shadow:inset 0 0 0 1px var(--ink)}
  .dl:hover::after{transform:translateY(2px);opacity:1}
  .card.dark .dl{background:transparent;color:#E8E4DE;box-shadow:inset 0 0 0 1px rgba(255,255,255,.28)}
  .card.dark .dl:hover{background:#fff;color:var(--ink);box-shadow:inset 0 0 0 1px #fff}
  dl{margin:0;display:grid;grid-template-columns:180px 1fr;gap:0}
  dt{font:500 12px/1.6 var(--mono);letter-spacing:.1em;text-transform:uppercase;
    color:var(--faint);padding:13px 0;border-top:1px solid var(--hair)}
  dd{margin:0;font:400 15px/1.6 var(--mono);color:var(--ink);padding:13px 0;border-top:1px solid var(--hair)}
  @media(max-width:640px){dl{grid-template-columns:1fr}dt{padding-bottom:2px;border-top:1px solid var(--hair)}dd{padding-top:2px;border-top:0}}
  .sw{display:flex;flex-wrap:wrap;gap:14px}
  .sw div{flex:1 1 150px}
  .chip{height:76px;border:1px solid var(--hair)}
  .sw code{font:500 11.5px/1.8 var(--mono);color:var(--soft);display:block;margin-top:8px}
  .copy{background:var(--bg2);border:1px solid var(--hair);padding:24px;
    font:400 15px/1.72 var(--mono);color:var(--ink);max-width:76ch;white-space:pre-wrap}
  .rules{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:8px}
  @media(max-width:720px){.rules{grid-template-columns:1fr}}
  .rules ul{margin:10px 0 0;padding-left:18px}
  .rules li{font:400 14px/1.85 var(--mono);color:var(--soft)}
  .yes b{color:var(--green)} .no b{color:#B3261E}
  .foot-x{display:inline-flex;align-items:center;gap:9px;text-decoration:none;color:var(--soft);
    font:500 11.5px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;padding:11px 15px;
    box-shadow:inset 0 0 0 1px var(--hair2);transition:color .2s,box-shadow .2s}
  .foot-x:hover{color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
  footer{padding:44px 0 80px;font:400 13px/1.7 var(--mono);color:var(--faint)}
  a{color:var(--ink)}

  /* ---------- phone ---------- */
  @media(max-width:640px){
    .wrap{width:calc(100% - 36px)}
    .nav-in{padding:13px 0}
    .brand{font-size:18px;gap:10px}
    .brand img{width:20px;height:20px}
    /* the nav already sits above it; the header needs far less air */
    header{padding:26px 0 30px}
    .kicker{margin:0 0 12px}
    h1{font-size:clamp(30px,9vw,40px)}
    .lede{font-size:14px;line-height:1.65;margin-top:16px}
    /* the bullet was overlapping the first word once the line wrapped */
    .status{align-items:flex-start;line-height:1.55;gap:8px;margin-top:20px;font-size:10.5px;letter-spacing:.12em}
    .status .dot{margin-top:5px}
    /* the glyph was stranded in white space between two big gaps */
    .head-grid{gap:22px}
    .head-art{padding-top:0}
    .head-art img{width:84px}
    section{padding:38px 0}
    h2{margin:0 0 20px}
    .grid,.socials{gap:12px}
    .card{min-height:0;padding:22px 18px 18px;gap:16px}
    .card img{max-height:74px}
    .banner{padding:14px}
    .banner .meta{gap:10px}
    /* 44px is the minimum comfortable tap target; these were 30px */
    .dl{min-height:44px;padding:0 16px;font-size:11px}
    .nav-links .btn{min-height:44px;padding:0 18px}
    .rules{gap:18px}
    .rules li{font-size:13px;line-height:1.7}
    .copy{padding:18px;font-size:13.5px;line-height:1.7}
    .sw div{flex-basis:calc(50% - 7px)}
    .chip{height:60px}
    dt{padding:12px 0 0}
    dd{padding:0 0 12px;font-size:13.5px}
    .legal{font-size:12.5px;line-height:1.75}
    footer{padding:30px 0 56px;font-size:11.5px}
  }
    </style>
